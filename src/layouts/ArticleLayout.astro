---
import BaseLayout from './BaseLayout.astro';
import PendingNotice from '../components/PendingNotice.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import JsonLd from '../components/JsonLd.astro';
import { articleSchema, breadcrumbSchema } from '../lib/schema';
import { url } from '../lib/url';
import { waContextMessage } from '../lib/whatsapp';

interface Props {
  title: string;
  description: string;
  category: string;
  publishDate: Date;
  updatedDate?: Date;
  faqs?: { question: string; answer: string }[];
}

const { title, description, category, publishDate, updatedDate, faqs = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const dateFmt = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
---

<BaseLayout title={title} description={description} ogType="article" waMessage={waContextMessage(title)}>
  <PendingNotice note="Draft article written for Lawrence — awaiting his review before launch." />
  <JsonLd
    slot="head"
    data={articleSchema({ title, description, url: canonical, datePublished: publishDate, dateModified: updatedDate })}
  />
  <JsonLd
    slot="head"
    data={breadcrumbSchema([
      { name: 'Home', url: new URL(url('/'), Astro.site).href },
      { name: 'Buyer Guides', url: new URL(url('/guides/'), Astro.site).href },
      { name: title, url: canonical },
    ])}
  />

  <article class="container-site max-w-3xl py-10 sm:py-14">
    <nav class="mb-6 text-sm text-ink/60" aria-label="Breadcrumb">
      <a href={url('/guides/')} class="hover:text-gold-600">Buyer Guides</a>
      <span class="mx-2">/</span>
      <span>{category}</span>
    </nav>

    <header class="mb-8">
      <span class="mb-3 inline-block rounded-full bg-gold-100 px-3 py-1 text-xs font-semibold text-gold-600">
        {category}
      </span>
      <h1 class="text-3xl sm:text-4xl">{title}</h1>
      <p class="mt-4 text-lg text-ink/70">{description}</p>
      <p class="mt-3 text-sm text-ink/50">
        Published {dateFmt.format(publishDate)}
        {updatedDate && ` · Updated ${dateFmt.format(updatedDate)}`}
        · by Lawrence Law
      </p>
      <div class="gold-rule mt-6 mb-0"></div>
    </header>

    <div class="prose-zh">
      <slot />
    </div>

    {faqs.length > 0 && (
      <div class="mt-12">
        <FAQ faqs={faqs} />
      </div>
    )}

    <div class="mt-10 rounded-xl border border-gold-500/40 bg-gold-100/40 p-6 text-center">
      <p class="font-medium text-navy-900">Did this article help?</p>
      <p class="mt-1 text-sm text-ink/70">Everyone’s situation is different — just tell me yours and I’ll give you advice tailored to it.</p>
    </div>
  </article>

  <CTASection waMessage={waContextMessage(title)} />
</BaseLayout>
