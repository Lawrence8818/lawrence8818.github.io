---
import { url } from '../lib/url';
import { waLink, waContextMessage } from '../lib/whatsapp';
import { landingHref } from '../lib/landing';
import { instalmentDisplay, instalmentDisplayZh, specsZh, LABEL_ZH } from '../lib/property-facts';
import { langOf, pick, href } from '../i18n';

interface Props {
  name: string;
  label?: string;
  /** kept as data only — never rendered (the site shows instalments, not prices) */
  priceFrom?: string;
  location: string;
  type?: string;
  tenure: string;
  landSize: string;
  layoutSize?: string;
  maintenance?: string;
  monthly?: string;
  completion: string;
  image: string;
  fallbackImage?: string;
  listingUrl?: string;
  /** Lawrence's own landing page — outranks the generated detail page */
  landingUrl?: string;
  placeholder?: boolean;
  soldOut?: boolean;
  penthouse?: boolean;
  /** content id — when present the card links through to /properties/<slug>/ */
  slug?: string;
}
const {
  name,
  label,
  location,
  type,
  tenure,
  landSize,
  layoutSize,
  monthly,
  completion,
  image,
  fallbackImage,
  listingUrl,
  landingUrl,
  placeholder = false,
  soldOut = false,
  penthouse = false,
  slug,
} = Astro.props;

const lang = langOf(Astro);
// 中文版的卡片一律进中文项目页(落地页只有英文)
const detailHref =
  lang === 'zh'
    ? slug
      ? href(lang, `/properties/${slug}/`)
      : undefined
    : landingHref(landingUrl) || (slug ? url(`/properties/${slug}/`) : undefined);

const specs =
  lang === 'zh'
    ? specsZh({ name, location, tenure, landSize, layoutSize, completion }).filter((s) => s.k !== '管理费')
    : [
        { k: 'Land Tenure', v: tenure },
        { k: 'Land Size', v: landSize },
        ...(layoutSize ? [{ k: 'Layout Size', v: layoutSize }] : []),
        { k: 'Completion', v: completion },
      ];
const contactMsg = waContextMessage(name, lang);
// The headline figure is the monthly instalment — the site never shows the
// selling price. Listings without one read "Instalment on request".
const instalment = pick(lang, instalmentDisplay, instalmentDisplayZh)({ monthly, soldOut });
const priceLabel = instalment.amount
  ? pick(lang, `From ${instalment.text} / month`, `月供 ${instalment.text} 起`)
  : instalment.text;
const labelText = label ? pick(lang, label, LABEL_ZH[label] ?? label) : undefined;
---

<article
  class:list={[
    'flex h-full flex-col overflow-hidden rounded-[4px] border',
    soldOut ? 'border-neutral-300 bg-neutral-100 grayscale' : 'border-border bg-white',
  ]}
>
  <div class="pc-media relative aspect-[3/2] overflow-hidden bg-navy-900">
    {detailHref ? (
      <a href={detailHref} aria-label={pick(lang, `View ${name} details`, `查看 ${name} 详情`)} class="block h-full w-full">
        <img
          src={url(image)}
          onerror={fallbackImage ? `this.onerror=null;this.src='${url(fallbackImage)}'` : undefined}
          alt={name}
          loading="lazy"
          class="h-full w-full object-cover object-top transition-transform duration-500 hover:scale-[1.04]"
        />
      </a>
    ) : (
      <img
        src={url(image)}
        onerror={fallbackImage ? `this.onerror=null;this.src='${url(fallbackImage)}'` : undefined}
        alt={name}
        loading="lazy"
        class="h-full w-full object-cover object-top"
      />
    )}
    {(label || penthouse) && (
      <span class="absolute top-3 left-3 flex flex-wrap gap-2">
        {penthouse && (
          <span class="label-sm rounded-full border border-gold-500 bg-navy-900/90 px-3 py-1 text-gold-500">
            Penthouse
          </span>
        )}
        {labelText && (
          <span class="label-sm rounded-full bg-gold-500 px-3 py-1 text-navy-900">{labelText}</span>
        )}
      </span>
    )}
    {placeholder && (
      <span class="absolute top-3 right-3 rounded bg-navy-900/85 px-2 py-0.5 text-xs text-white">
        等待 · Photo pending
      </span>
    )}
    {soldOut && (
      <span class="label-sm absolute top-3 right-3 rounded bg-navy-900/90 px-3 py-1 text-white">
        {pick(lang, 'Sold Out', '已售完')}
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col gap-4 p-5">
    <div>
      <h3 class="font-sans text-lg leading-snug font-semibold text-navy-900">
        {detailHref ? (
          <a href={detailHref} class="transition-colors hover:text-gold-600">{name}</a>
        ) : (
          name
        )}
      </h3>
      <p class="mt-0.5 text-sm text-ink/70">{location}{type && ` · ${type}`}</p>
    </div>

    <p class="text-[22px] font-bold text-navy-900">{priceLabel}</p>

    <dl class="grid grid-cols-2 gap-x-4 gap-y-2.5 border-t border-border pt-4">
      {specs.map((s) => (
        <div>
          <dt class="label-sm text-ink/50">{s.k}</dt>
          <dd class="mt-0.5 text-[15px] font-medium text-navy-900">{s.v}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-auto grid grid-cols-2 gap-3 pt-2">
      <a href={waLink(contactMsg)} target="_blank" rel="noopener" class="btn-gold !px-4 !py-2.5 !text-sm" data-track="whatsapp_property">
        {pick(lang, 'Contact Us', '联系我')}
      </a>
      {detailHref ? (
        <a href={detailHref} class="btn-gold-outline !px-4 !py-2.5 !text-sm">{pick(lang, 'View Details', '查看详情')}</a>
      ) : (
        <a
          href={listingUrl || waLink(contactMsg)}
          target="_blank"
          rel="noopener"
          data-track={listingUrl ? undefined : 'whatsapp_property'}
          class="btn-gold-outline !px-4 !py-2.5 !text-sm"
        >
          View Listing
        </a>
      )}
    </div>
  </div>
</article>
