---
import { url } from '../lib/url';
import { SITE } from '../data/site';
import GoldIcon from './GoldIcon.astro';

const year = new Date().getFullYear();

const quickLinks = [
  { href: url('/allproperties'), label: 'Properties' },
  { href: url('/guides/'), label: 'Buyer Guides' },
  { href: url('/videos/'), label: 'Videos' },
  { href: url('/areas/'), label: 'Areas' },
  { href: url('/spasignings'), label: 'Testimonials' },
  { href: url('/about/'), label: 'About' },
  { href: url('/contact/'), label: 'Contact' },
];

const socialEntries = [
  { key: 'facebook', label: 'Facebook', href: SITE.socials.facebook },
  { key: 'instagram', label: 'Instagram', href: SITE.socials.instagram },
  { key: 'tiktok', label: 'TikTok', href: SITE.socials.tiktok },
  { key: 'youtube', label: 'YouTube', href: SITE.socials.youtube },
  { key: 'xiaohongshu', label: 'XHS · Lawrence Law 刘智权', href: SITE.socials.xiaohongshu },
].filter((s) => s.href);
---

<footer class="bg-navy-900 text-navy-100">
  <div class="container-site grid gap-10 py-14 text-[15px] sm:grid-cols-2 lg:grid-cols-[1.2fr_0.7fr_1.1fr] lg:gap-14">
    <div>
      <p class="label-sm mb-3 text-gold-500">Contact</p>
      <ul>
        <li>
          <a href={`https://wa.me/${SITE.whatsappNumber}`} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-2 transition-colors hover:text-gold-500" data-track="whatsapp_footer">
            <span class="text-gold-500"><GoldIcon name="phone" size={16} /></span>
            +6019-9939 860
          </a>
        </li>
        <li>
          <a href={`mailto:${SITE.email}`} class="inline-flex min-h-11 items-center gap-2 transition-colors hover:text-gold-500">
            <span class="text-gold-500"><GoldIcon name="mail" size={16} /></span>
            {SITE.email}
          </a>
        </li>
        <li class="flex items-start gap-2 py-2">
          <span class="mt-1 text-gold-500"><GoldIcon name="pin" size={16} /></span>
          <span>{SITE.address}</span>
        </li>
        {socialEntries.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-2.5 transition-colors hover:text-gold-500">
              {s.key === 'facebook' && (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="flex-none"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              )}
              {s.key === 'instagram' && (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="flex-none"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect><circle cx="12" cy="12" r="4.5"></circle><circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none"></circle></svg>
              )}
              {s.key === 'tiktok' && (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="flex-none"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
              )}
              {s.key === 'youtube' && (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="flex-none"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              )}
              {s.key === 'xiaohongshu' && (
                <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true" class="flex-none"><rect x="1.5" y="1.5" width="21" height="21" rx="5" fill="currentColor"></rect><text x="12" y="16.2" text-anchor="middle" font-size="11" font-weight="700" fill="#0a2540" font-family="system-ui, -apple-system, sans-serif">红</text></svg>
              )}
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="label-sm mb-3 text-gold-500">Quick Links</p>
      <ul>
        {quickLinks.map((l) => (
          <li>
            <a href={l.href} class="inline-flex min-h-11 items-center transition-colors hover:text-gold-500">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="lg:text-right">
      <p class="font-display text-xl font-bold text-white">Lawrence Law {SITE.nameZh}</p>
      <p class="mt-2 leading-relaxed">
        {SITE.tagline}. Serving the entire Malaysia New Properties.
      </p>
      <p class="label-sm mt-3 text-navy-100/70">{SITE.renNumber} · {SITE.agencyName}</p>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-site py-5 text-center text-[13px] text-navy-100/60">
      <p>
        Content on this site is for general reference only and does not constitute investment or
        legal advice.
      </p>
      <p class="mt-1">
        © {year} Lawrence Law Property™ · All Rights Reserved ·
        <a href={url('/privacy/')} class="hover:text-gold-500">Privacy Policy</a> |
        <a href={url('/terms/')} class="hover:text-gold-500">Terms of Service</a>
      </p>
    </div>
  </div>
</footer>
