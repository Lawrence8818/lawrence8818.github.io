---
import { url } from '../lib/url';
import { waLink } from '../lib/whatsapp';
import { SITE } from '../data/site';

// Absolute URLs throughout: the site is published page-by-page on
// lawrencelawproperty.com, so the shared menu must work from any pasted page.
// Section links (#videos/#areas/#testimonials) land on the main page.
const navItems = [
  { href: url('/'), label: 'Home' },
  { href: 'https://lawrencelawproperty.com/allproperties', label: 'Properties' },
  { href: 'https://lawrencelawproperty.com/buyerguide', label: 'Buyer Guides' },
  { href: 'https://lawrencelawproperty.com/#areas', label: 'Areas' },
  { href: 'https://lawrencelawproperty.com/spasignings', label: 'Client Stories' },
  { href: 'https://lawrencelawproperty.com/about', label: 'About' },
  { href: waLink(), label: 'Contact', external: true },
];
---

<header class="sticky top-0 z-40 bg-navy-900">
  <div class="container-site flex h-[72px] items-center justify-between gap-3">
    <a href={url('/')} class="flex min-w-0 items-center gap-3" aria-label="LLP Property — home">
      {/* Gold emblem image + the LLP PROPERTY wordmark recreated in type,
          matching Lawrence's logo lockup (crisp at any size) */}
      <img
        src={url('/images/logo.png')}
        onerror="this.style.display='none'"
        alt=""
        class="h-12 w-auto flex-none"
      />
      <span class="flex flex-col justify-center">
        <span class="text-[22px] leading-none font-semibold tracking-[7px] text-white">LLP</span>
        <span class="mt-1 text-[9.5px] leading-none font-semibold tracking-[4.5px] text-gold-500">PROPERTY</span>
      </span>
    </a>

    <div class="flex flex-none items-center gap-2 sm:gap-3">
      <a
        href={waLink()}
        target="_blank"
        rel="noopener"
        class="btn-gold !px-4 !py-2 !text-sm sm:!px-5 sm:!py-2.5"
        data-track="whatsapp_header"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="flex-none">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.359.101 11.892c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652a11.899 11.899 0 0 0 5.71 1.427h.006c6.585 0 11.946-5.359 11.949-11.893C24 8.694 22.85 5.612 20.52 3.449"/>
        </svg>
        WhatsApp
      </a>
      <button
        id="menu-toggle"
        class="flex h-11 w-11 items-center justify-center rounded-md text-white transition-colors hover:text-gold-500"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <svg id="menu-icon-open" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="7" x2="21" y2="7"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="17" x2="21" y2="17"></line>
        </svg>
        <svg id="menu-icon-close" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden">
          <line x1="5" y1="5" x2="19" y2="19"></line>
          <line x1="19" y1="5" x2="5" y2="19"></line>
        </svg>
      </button>
    </div>
  </div>

  {/* Collapsed menu — opens on click, all screen sizes */}
  <nav id="site-menu" class="hidden border-t border-gold-500/30 bg-navy-900" aria-label="Site menu">
    <div class="container-site py-4">
      <div class="grid gap-1 sm:grid-cols-2">
        {navItems.map((item) => (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener' : undefined}
            class="rounded-md px-3 py-3 text-lg font-medium text-white transition-colors hover:bg-white/5 hover:text-gold-500"
          >
            {item.label}
          </a>
        ))}
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-1 border-t border-white/10 pt-4 text-sm text-navy-100">
        <span>+6019-9939 860</span>
        <span>{SITE.email}</span>
        <span class="label-sm text-gold-500">{SITE.renNumber}</span>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-toggle');
    var menu = document.getElementById('site-menu');
    var iconOpen = document.getElementById('menu-icon-open');
    var iconClose = document.getElementById('menu-icon-close');
    if (!btn || !menu) return;
    function setOpen(open) {
      menu.classList.toggle('hidden', !open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    }
    btn.addEventListener('click', function () {
      setOpen(menu.classList.contains('hidden'));
    });
    // Auto-collapse after picking a menu item — matters for same-page
    // anchor links (and new-tab links) where no page reload closes it.
    menu.addEventListener('click', function (e) {
      if (e.target && e.target.closest && e.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>
