---
import { getCollection } from 'astro:content';
import { SITE } from '../data/site';
import { url } from '../lib/url';
import { monthlyNumber } from '../lib/property-facts';
import { langOf, pick, href } from '../i18n';
import { QUIZ_ZH } from '../i18n/copy-zh';

const lang = langOf(Astro);
const zh = lang === 'zh';

// 30-second property match quiz — 3 taps (monthly budget / area / size). The result
// step shows only HOW MANY projects match; the list itself is locked and the
// only way to get it is the WhatsApp button, which arrives at Lawrence's
// phone with all three answers pre-filled. Zero backend.
const ALLPROPS = href(lang, '/allproperties/');

// Compact dataset for the client-side match count: [monthly, region, sizeMin,
// sizeMax] per live listing. Parsing and matching mirror the All Properties
// page (src/pages/properties/index.astro) so the count equals what the full
// filter UI would show. Budget is matched on the monthly instalment — selling
// prices are never sent to the browser.
const live = (await getCollection('properties')).filter((p) => !p.data.soldOut);
const parseSize = (s?: string) => {
  const nums = ((s || '').match(/[\d,]+/g) || [])
    .map((n) => parseInt(n.replace(/,/g, ''), 10))
    .filter((n) => n > 0);
  return nums.length ? { min: Math.min(...nums), max: Math.max(...nums) } : null;
};
const PROPS = live.map((p) => {
  const sz = parseSize(p.data.layoutSize);
  return [
    monthlyNumber(p.data.monthly) ?? 0,
    p.data.region ?? '',
    sz ? sz.min : 0,
    sz ? sz.max : 0,
  ];
});
const WA_NUMBER = SITE.whatsappNumber;

const STEPS_EN = [
  {
    key: 'budget',
    q: 'What monthly instalment suits you?',
    opts: [
      { label: 'Under RM2,000', v: 'mmax=2000' },
      { label: 'RM2,000 – 3,500', v: 'mmin=2000&mmax=3500' },
      { label: 'RM3,500 – 6,000', v: 'mmin=3500&mmax=6000' },
      { label: 'Above RM6,000', v: 'mmin=6000' },
      { label: 'Flexible', v: '' },
    ],
  },
  {
    key: 'area',
    q: 'Where do you want to live?',
    opts: [
      { label: 'Kuala Lumpur', v: 'region=kuala-lumpur' },
      { label: 'KLCC', v: 'region=klcc' },
      { label: 'Petaling Jaya', v: 'region=petaling-jaya' },
      { label: 'Selangor', v: 'region=selangor' },
      { label: 'Anywhere', v: '' },
    ],
  },
  {
    key: 'size',
    q: 'How much space do you need?',
    opts: [
      { label: 'Cosy · 2 rooms', v: 'smax=900' },
      { label: 'Family · 3 rooms', v: 'smin=900&smax=1250' },
      { label: 'Spacious · 4+ rooms', v: 'smin=1250' },
      { label: 'Not sure yet', v: '' },
    ],
  },
];
// 中文版:题目和选项的文字换成中文,选项背后的筛选条件(v)不变
const STEPS = zh
  ? STEPS_EN.map((s, i) => ({
      ...s,
      q: QUIZ_ZH.steps[i].q,
      opts: s.opts.map((o, j) => ({ ...o, label: QUIZ_ZH.steps[i].opts[j] })),
    }))
  : STEPS_EN;

// WhatsApp 讯息在浏览器里拼,这里把各个片段按语言备好
const MSG = zh
  ? QUIZ_ZH.msg
  : {
      head: 'Hi Lawrence, I just did the property match quiz on your website. My answers — Monthly budget: ',
      area: ' | Area: ',
      space: ' | Space: ',
      found1: '. It found ',
      found2: ' matching projects — please send me the list.',
      none: '. No exact match came up — can you recommend something for me?',
      flexible: 'Flexible',
      anywhere: 'Anywhere',
      unsure: 'Not sure yet',
    };
---

<section id="match-quiz" class="border-y border-gold-500/25 bg-navy-950 py-14 text-white sm:py-20">
  <div class="container-site">
    <p class="label-sm mb-3 text-gold-500">{pick(lang, 'Property Match', QUIZ_ZH.eyebrow)}</p>
    <h2 class="section-heading text-white">{pick(lang, 'Find Your Match in 30 Seconds', QUIZ_ZH.heading)}</h2>
    <div class="gold-rule"></div>
    <p class="mb-8 max-w-2xl text-[17px] leading-[1.8] text-navy-100">
      {pick(lang, 'Three quick taps — budget, area, space — and I’ll match you against every project on my list.', QUIZ_ZH.intro)}
    </p>

    <div class="mq max-w-3xl rounded-[6px] border border-white/15 bg-white/[0.04] p-6 sm:p-8">
      {STEPS.map((s, i) => (
        <div class="mq-step" data-step={i} style={i > 0 ? 'display:none' : undefined}>
          <div class="mb-4 flex items-baseline justify-between gap-3">
            <p class="text-[19px] font-bold text-white sm:text-[22px]">{s.q}</p>
            <span class="label-sm flex-none text-navy-100/70">{i + 1} / {STEPS.length}</span>
          </div>
          <div class="flex flex-wrap gap-2.5">
            {s.opts.map((o) => (
              <button
                type="button"
                class="mq-opt label-sm inline-flex min-h-11 items-center rounded-full border border-white/40 px-5 py-2 text-white transition hover:border-gold-500 hover:text-gold-500"
                data-v={o.v}
              >
                {o.label}
              </button>
            ))}
          </div>
          {i > 0 && (
            <button type="button" class="mq-back mt-5 inline-flex min-h-11 items-center text-sm text-navy-100/70 hover:text-gold-500">
              {pick(lang, '← Back', QUIZ_ZH.back)}
            </button>
          )}
        </div>
      ))}

      {/* result step — count teaser only; the list itself stays locked */}
      <div class="mq-step" data-step="3" style="display:none">
        <p class="text-[19px] font-bold text-white sm:text-[22px]">
          <span class="mq-count-line">{pick(lang, '✓ ', QUIZ_ZH.countBefore)}<span class="mq-count text-gold-500">0</span>{pick(lang, ' projects match your answers.', QUIZ_ZH.countAfter)}</span>
          <span class="mq-zero-line" style="display:none">{pick(lang, 'Nothing exact — but I can match you personally.', QUIZ_ZH.zero)}</span>
        </p>
        <div class="mt-4 flex items-start gap-3 rounded-[4px] border border-gold-500/40 bg-navy-900/60 p-4">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 flex-none text-gold-500" aria-hidden="true">
            <rect x="4" y="10" width="16" height="10" rx="2"></rect>
            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
          </svg>
          <p class="text-[15px] leading-relaxed text-navy-100">
            <span class="mq-lock-copy">{pick(lang, 'Your personalised shortlist is ready — locked to keep it personal.', QUIZ_ZH.lock)}</span>
            {pick(lang, 'WhatsApp me your answers with one tap and I’ll send the full list, with layouts and instalment estimates, usually within the hour.', QUIZ_ZH.lockRest)}
          </p>
        </div>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a class="mq-wa btn-gold" href="#" target="_blank" rel="noopener" data-track="whatsapp_quiz">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="flex-none"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.359.101 11.892c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652a11.899 11.899 0 0 0 5.71 1.427h.006c6.585 0 11.946-5.359 11.949-11.893C24 8.694 22.85 5.612 20.52 3.449"/></svg>
            {pick(lang, 'Unlock My List on WhatsApp', QUIZ_ZH.unlock)}
          </a>
          <button type="button" class="mq-restart btn-gold-outline text-white">{pick(lang, 'Start Over', QUIZ_ZH.restart)}</button>
        </div>
        <p class="mt-3 text-[13px] text-navy-100/70">
          {pick(lang, 'One tap opens WhatsApp with your answers pre-filled — just press send. No forms, no spam.', QUIZ_ZH.note)}
        </p>
      </div>

      {/* no-JS fallback keeps the section useful */}
      <noscript>
        <a class="btn-gold mt-4" href={ALLPROPS}>{pick(lang, 'Browse All Properties', QUIZ_ZH.browse)}</a>
      </noscript>
    </div>
  </div>
</section>

<script is:inline define:vars={{ PROPS, WA_NUMBER, MSG }}>
  (function () {
    var root = document.getElementById('match-quiz');
    if (!root) return;
    var steps = Array.prototype.slice.call(root.querySelectorAll('.mq-step'));
    var picks = [];   // query fragments, e.g. "mmin=2000&mmax=3500"
    var labels = [];  // human-readable, e.g. "RM2,000 – 3,500"
    var cur = 0;

    function show(i) {
      cur = i;
      steps.forEach(function (s) {
        s.style.display = +s.dataset.step === i ? '' : 'none';
      });
      if (i === 3) finish();
    }

    function params() {
      var out = {};
      picks.filter(Boolean).join('&').split('&').forEach(function (kv) {
        if (!kv) return;
        var p = kv.split('=');
        out[p[0]] = p[1];
      });
      return out;
    }

    // Same rules as the All Properties filter: sold-out already excluded from
    // PROPS; listings without size data always pass the size filter; listings
    // without an instalment figure only pass when no budget is chosen.
    function countMatches() {
      var q = params();
      var pmin = +q.mmin || 0;
      var pmax = +q.mmax || Infinity;
      var smin = +q.smin || 0;
      var smax = +q.smax || Infinity;
      var region = q.region || 'all';
      var n = 0;
      PROPS.forEach(function (p) {
        var price = p[0], reg = p[1], mn = p[2], mx = p[3];
        if (pmin > 0 || pmax !== Infinity) {
          if (!price || price < pmin || price > pmax) return;
        }
        if (mn > 0 && mx > 0 && (mx < smin || mn > smax)) return;
        if (region !== 'all' && reg !== region) return;
        n++;
      });
      return n;
    }

    function finish() {
      var n = countMatches();
      var budget = labels[0] || MSG.flexible;
      var area = labels[1] || MSG.anywhere;
      var size = labels[2] || MSG.unsure;

      root.querySelector('.mq-count').textContent = n;
      root.querySelector('.mq-count-line').style.display = n > 0 ? '' : 'none';
      root.querySelector('.mq-zero-line').style.display = n > 0 ? 'none' : '';
      root.querySelector('.mq-lock-copy').style.display = n > 0 ? '' : 'none';

      var msg =
        MSG.head + budget + MSG.area + area + MSG.space + size +
        (n > 0 ? MSG.found1 + n + MSG.found2 : MSG.none);
      root.querySelector('.mq-wa').href =
        'https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(msg);

      // Answers reach the analytics even if the buyer never presses send.
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'quiz_complete', {
          budget: budget, area: area, space: size, matches: n,
        });
      }
    }

    steps.forEach(function (s, idx) {
      s.querySelectorAll('.mq-opt').forEach(function (btn) {
        btn.addEventListener('click', function () {
          picks[idx] = btn.dataset.v;
          labels[idx] = btn.textContent.trim();
          // highlight the chosen chip for when the buyer comes Back
          s.querySelectorAll('.mq-opt').forEach(function (b) {
            b.classList.toggle('mq-on', b === btn);
          });
          show(idx + 1);
        });
      });
      var back = s.querySelector('.mq-back');
      if (back) back.addEventListener('click', function () { show(idx - 1); });
    });

    var restart = root.querySelector('.mq-restart');
    if (restart)
      restart.addEventListener('click', function () {
        picks = [];
        labels = [];
        root.querySelectorAll('.mq-opt').forEach(function (b) { b.classList.remove('mq-on'); });
        show(0);
      });
  })();
</script>

<style>
  .mq-opt.mq-on {
    border-color: #c9a227;
    background: #c9a227;
    color: #0a2540;
  }
</style>
