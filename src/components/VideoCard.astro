---
import { url } from '../lib/url';

interface Props {
  slug: string;
  title: string;
  titleZh?: string;
  category: string;
  platform: string;
  thumbnail: string;
  videoId?: string;
  longform?: boolean;
}
const { slug, title, titleZh, category, platform, thumbnail, videoId, longform } = Astro.props;

// videoId 还是 TODO 占位时,退回本地占位图,避免请求必然 404 的 YouTube 缩略图
const realYtId = platform === 'youtube' && videoId && !videoId.includes('TODO') ? videoId : null;
const thumbSrc =
  realYtId && thumbnail.startsWith('/images/placeholders/')
    ? `https://i.ytimg.com/vi/${realYtId}/hqdefault.jpg`
    : url(thumbnail);
---

<a href={url(`/videos/${slug}/`)} class="card group block overflow-hidden !p-0">
  <div class="relative aspect-video overflow-hidden bg-navy-950">
    <img
      src={thumbSrc}
      alt={title}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    <span class="absolute top-3 left-3 rounded-full bg-gold-500 px-2.5 py-0.5 text-xs font-semibold text-navy-950">
      {category}
    </span>
    {longform && (
      <span class="absolute top-3 right-3 rounded-full bg-navy-900/90 px-2.5 py-0.5 text-xs font-semibold text-white">
        Long-form
      </span>
    )}
  </div>
  <div class="p-4">
    <h3 class="text-base leading-snug font-medium text-navy-900 group-hover:text-gold-600">{title}</h3>
    {titleZh && <p class="mt-1 text-sm leading-snug text-ink/55">{titleZh}</p>}
  </div>
</a>
