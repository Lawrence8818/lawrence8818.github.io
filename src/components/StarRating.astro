---
// Five gold SVG stars (no glyph-as-icon). `size` is per-star px; extra classes
// let each caller keep its old spacing/alignment.
interface Props {
  size?: number;
  class?: string;
}
const { size = 16, class: cls = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-0.5 text-gold-500', cls]} role="img" aria-label="5 out of 5 stars">
  {[0, 1, 2, 3, 4].map(() => (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="flex-none">
      <path d="M12 2.2l2.95 5.98 6.6.96-4.77 4.65 1.13 6.57L12 17.25l-5.91 3.11 1.13-6.57L2.45 9.14l6.6-.96z" />
    </svg>
  ))}
</span>
