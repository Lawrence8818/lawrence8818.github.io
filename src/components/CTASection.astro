---
import { waLink } from '../lib/whatsapp';
import { SITE } from '../data/site';

interface Props {
  heading?: string;
  sub?: string;
  /** WhatsApp prefilled message (with page context) */
  waMessage?: string;
}
const {
  heading = 'Click the button to contact us now!',
  sub = 'Get the most updated information on real estate.',
  waMessage,
} = Astro.props;
---

<section class="bg-navy-900">
  <div class="container-site py-14 sm:py-20">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 rounded-[4px] border border-white/15 bg-white/5 px-6 py-12 text-center sm:px-12">
      <h2 class="text-[26px] text-white sm:text-4xl">{heading}</h2>
      <p class="max-w-xl text-navy-100">{sub}</p>
      <a href={waLink(waMessage)} target="_blank" rel="noopener" class="btn-gold" data-track="whatsapp_cta_section">
        CONTACT US NOW!
      </a>
      <p class="text-sm text-navy-100">
        Prefer email? <a href={`mailto:${SITE.email}`} class="font-semibold text-gold-500 underline decoration-gold-500/50 underline-offset-4 hover:decoration-gold-500">{SITE.email}</a>
      </p>
      <p class="text-sm text-navy-100/60">Real person, real reply — usually within 5 minutes</p>
    </div>
  </div>
</section>
