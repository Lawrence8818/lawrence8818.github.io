---
import { waLink, WA_DEFAULT_ZH } from '../lib/whatsapp';
import { langOf, pick } from '../i18n';
import { SITE } from '../data/site';

interface Props {
  heading?: string;
  sub?: string;
  /** WhatsApp prefilled message (with page context) */
  waMessage?: string;
}
const lang = langOf(Astro);
const {
  heading = pick(lang, 'Click the button to contact us now!', '想了解更多？现在就联系我'),
  sub = pick(lang, 'Get the most updated information on real estate.', '第一时间拿到最新的房产资讯。'),
  waMessage,
} = Astro.props;
---

<section class="bg-navy-900">
  <div class="container-site py-14 sm:py-20">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 rounded-[4px] border border-white/15 bg-white/5 px-6 py-12 text-center sm:px-12">
      <h2 class="text-[26px] text-white sm:text-4xl">{heading}</h2>
      <p class="max-w-xl text-navy-100">{sub}</p>
      <a href={waLink(waMessage ?? pick(lang, undefined, WA_DEFAULT_ZH))} target="_blank" rel="noopener" class="btn-gold" data-track="whatsapp_cta_section">
        {pick(lang, 'CONTACT US NOW!', '马上联系我')}
      </a>
      <p class="text-sm text-navy-100">
        {pick(lang, 'Prefer email?', '想用电邮？')} <a href={`mailto:${SITE.email}`} class="font-semibold text-gold-500 underline decoration-gold-500/50 underline-offset-4 hover:decoration-gold-500">{SITE.email}</a>
      </p>
      <p class="text-sm text-navy-100/60">{pick(lang, 'Real person, real reply — usually within 5 minutes', '本人亲自回复，通常 5 分钟内')}</p>
    </div>
  </div>
</section>
