---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import CTASection from '../components/CTASection.astro';
import PillarsAndStory from '../components/PillarsAndStory.astro';
import ComebackStory from '../components/ComebackStory.astro';
import { AWARDS } from '../data/awards';
import { SITE } from '../data/site';
import { url } from '../lib/url';
import JsonLd from '../components/JsonLd.astro';
import { profileSchema } from '../lib/schema';
import { langOf, pick } from '../i18n';
import { introParasZh, INTRO_CLOSING_ZH, TAGLINE_ZH, AWARDS_ZH } from '../i18n/copy-zh';

// 这个模板同时出英文页(/about/)和中文页(/zh/about/)
const lang = langOf(Astro);
const zh = lang === 'zh';

const description =
  'From subsales to new property, a decade of hands-on experience you can count on. Trusted by 2,000+ buyers over the years, since 2015. Registered estate negotiator (REN 26610) serving KL, Selangor, Johor and Penang.';
const siteUrl = Astro.site?.href ?? 'https://www.lawrencelawproperty.com/';
---

<BaseLayout
  title={pick(lang, 'About Lawrence Law — New Property Specialist with Subsales Expertise', `关于 ${SITE.name} ${SITE.nameZh} — 新盘专家，兼具二手房经验`)}
  description={pick(
    lang,
    description,
    `从二手房到新盘，十年实战经验。自 ${SITE.since} 年起累计获得 2,000 多位买家的信任。马来西亚注册房地产谈判员（${SITE.renNumber}），服务吉隆坡、雪兰莪、柔佛和槟城。`,
  )}
>
  <JsonLd
    slot="head"
    data={profileSchema({
      siteUrl,
      url: new URL(Astro.url.pathname, Astro.site).href,
      description:
        `${SITE.tagline}. Registered estate negotiator in Malaysia (${SITE.renNumber}), in real estate since ${SITE.since}, ` +
        `serving ${SITE.serviceAreas.join(', ')}.`,
    })}
  />
  {/* ===== Intro: photo + story on navy ===== */}
  <section class="bg-navy-900 py-14 text-white sm:py-20">
    <div class="container-site grid items-center gap-10 lg:grid-cols-[2fr_3fr]">
      <div class="mx-auto w-full max-w-sm">
        <img
          src={url('/images/lawrence-portrait.jpg')}
          onerror={`this.onerror=null;this.src='${url('/images/placeholders/lawrence-about.svg')}'`}
          alt={pick(lang, 'Lawrence Law, New Property Specialist', 'Lawrence Law 刘智权，新盘专家')}
          class="aspect-[4/5] w-full rounded-lg border border-gold-500/50 object-cover shadow-card"
        />
      </div>
      <div>
        <h1 class="text-[32px] text-white sm:text-[52px]">{pick(lang, 'Hi! I’m Lawrence Law', `你好！我是 ${SITE.name} ${SITE.nameZh}`)}</h1>
        <p class="mt-2 font-display text-[22px] font-semibold text-gold-500 sm:text-[30px]">{pick(lang, SITE.tagline, TAGLINE_ZH)}</p>
        <div class="gold-rule mt-5"></div>
        <div class="space-y-4 text-navy-100">
          {zh && introParasZh('font-bold text-gold-500').map((html) => <p set:html={html} />)}
          {zh && <p class="text-white">{INTRO_CLOSING_ZH}</p>}
          {!zh && (
          <>
          <p>
            From subsales to new property — a decade of hands-on experience you can count on.
            Guiding young couples and families toward the right home
            <strong class="font-bold text-gold-500">since 2015</strong>.
          </p>
          <p>
            My real estate journey began at university, where I started out in the subsales market —
            helping clients buy, sell and rent with confidence. Over my first four years, I built the
            trust of a growing community of <strong class="font-bold text-gold-500">1,500+ homeowners</strong>.
          </p>
          <p>
            In 2019, I moved into new property sales, combining hands-on subsales experience with
            in-depth project knowledge — bringing my journey to a full decade in the industry.
          </p>
          <p>
            Today, trusted by <strong class="font-bold text-gold-500">2,000+ buyers</strong> over the
            years, I specialise in helping families upgrade, first-time homebuyers choose the right
            location, and busy professionals find practical, future-ready homes.
          </p>
          <p>
            Most recently ranked <strong class="font-bold text-gold-500">Top 47 nationwide</strong> (Primary
            Market, 2025) and a <strong class="font-bold text-gold-500">Million Dollar Achiever Club —
            Diamond</strong> member at the IQI Prestige Awards.
          </p>
          <p class="text-white">
            If you’re looking for honest, no-pressure advice to make the right property move — let’s talk.
          </p>
          </>
          )}
        </div>
      </div>
    </div>
  </section>

  <TrustBar />

  <PillarsAndStory />

  <ComebackStory />

  {/* ===== Awards ===== */}
  <section class="section-pad bg-cream">
    <div class="container-site">
      <h2 class="section-heading">{pick(lang, 'Awards & Recognition', '奖项与肯定')}</h2>
      <div class="gold-rule"></div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {AWARDS.map((a, i) => (
          <figure class="card">
            <div class="relative aspect-[4/3] overflow-hidden rounded-lg bg-navy-900">
              {a.image ? (
                <img
                  src={url(a.image)}
                  onerror={a.fallbackImage ? `this.onerror=null;this.src='${url(a.fallbackImage)}'` : undefined}
                  alt={zh ? AWARDS_ZH[i] : a.title}
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center">
                  <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#c9a227" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M8 21h8"></path>
                    <path d="M12 17v4"></path>
                    <path d="M7 4h10v4a5 5 0 0 1-10 0V4Z"></path>
                    <path d="M7 5H4v2a3 3 0 0 0 3 3"></path>
                    <path d="M17 5h3v2a3 3 0 0 1-3 3"></path>
                  </svg>
                </div>
              )}
            </div>
            <figcaption class="mt-3">
              <p class="font-semibold text-navy-900">{zh ? AWARDS_ZH[i] : a.title}</p>
              <p class="text-sm text-ink/60">{zh ? a.year : `${a.org} · ${a.year}`}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    heading={pick(lang, 'Looking for honest, no-pressure advice?', '想听实话、不被催促的建议？')}
    sub={pick(lang, 'Tell me your budget and your plans — whether to buy, when to buy, where to buy is always your call.', '把你的预算和计划告诉我。买不买、什么时候买、买在哪里，决定权永远在你手上。')}
    waMessage={pick(lang, 'Hi Lawrence, I read your story on the website and would like some advice on my property plans.', '你好 Lawrence，我在网站上看了你的故事，想请你给我的买房计划一些建议。')}
  />
</BaseLayout>
