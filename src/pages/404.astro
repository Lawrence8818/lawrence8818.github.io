---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page Not Found" description="The page you’re looking for doesn’t exist or has moved.">
  <section class="py-24 text-center">
    <div class="container-site">
      <p class="font-display text-7xl font-bold text-gold-500">404</p>
      <h1 class="mt-4 text-2xl">This page doesn’t exist</h1>
      <p class="mt-3 text-ink/70">The link may be wrong, or the page has moved.</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={url('/')} class="btn-gold">Back to home</a>
        <a href={url('/guides/')} class="btn-gold-outline">Browse the buyer guides</a>
      </div>
    </div>
  </section>
</BaseLayout>
