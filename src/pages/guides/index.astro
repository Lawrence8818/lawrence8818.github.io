---
import PendingNotice from '../../components/PendingNotice.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CTASection from '../../components/CTASection.astro';
import { url } from '../../lib/url';

const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const categories = ['The Buying Process', 'Avoiding Pitfalls', 'Loans & Financing', 'Buying Basics'] as const;
const byCategory = categories
  .map((cat) => ({ cat, items: guides.filter((g) => g.data.category === cat) }))
  .filter((c) => c.items.length > 0);
---

<BaseLayout
  title="Buyer Guides: Property Know-How, Pitfalls & Loan Tips in Malaysia"
  description="A complete knowledge base for buying property in Malaysia: the buying process, SPA pitfalls, DSR loan tips, handover inspection. Practical guides for first-time buyers and upgraders, updated regularly."
>
  <PendingNotice note="Draft articles written for Lawrence — awaiting his review before launch." />
  <section class="bg-navy-900 py-12 text-white">
    <div class="container-site">
      <h1 class="text-3xl sm:text-4xl text-white">Buyer Guides</h1>
      <p class="mt-3 max-w-2xl text-navy-100">
        This is the know-how I usually explain to clients one on one. I’m writing it up free — because
        an informed buyer is a good client.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="container-site space-y-14">
      {byCategory.map(({ cat, items }) => (
        <div>
          <SectionHeading title={cat} />
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((g) => (
              <a href={url(`/guides/${g.id}/`)} class="card group block">
                <h2 class="text-lg leading-snug group-hover:text-gold-600">{g.data.title}</h2>
                <p class="mt-2 line-clamp-3 text-sm text-ink/70">{g.data.description}</p>
                <p class="mt-4 text-sm font-semibold text-gold-600">Read more →</p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <CTASection
    heading="Your question not covered by an article?"
    sub="Just ask me. Your question might well be the topic of my next article or next video."
  />
</BaseLayout>
