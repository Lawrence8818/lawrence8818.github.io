---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import VideoCard from '../../components/VideoCard.astro';
import CTASection from '../../components/CTASection.astro';
import JsonLd from '../../components/JsonLd.astro';
import { videoSchema, breadcrumbSchema } from '../../lib/schema';
import { url } from '../../lib/url';
import { waContextMessage } from '../../lib/whatsapp';
import { langOf, pick, href } from '../../i18n';
import { VIDEO_CATEGORY_ZH } from '../../i18n/videos';

export async function getStaticPaths() {
  const videos = await getCollection('videos');
  return videos.map((v) => ({ params: { slug: v.id }, props: { video: v } }));
}

const { video } = Astro.props;
const astroLang = Astro.currentLocale === 'zh' ? 'zh' : 'en';
// 这个模板同时出英文页(/videos/…)和中文页(/zh/videos/…)
const lang = langOf(Astro);
const zh = lang === 'zh';
const title = zh && video.data.titleZh ? video.data.titleZh : video.data.title;
const blurb = zh ? (video.data.descriptionZh ?? '') : video.data.description;
const catLabel = zh ? (VIDEO_CATEGORY_ZH[video.data.category] ?? video.data.category) : video.data.category;
// 英文页的正文在这支视频自己的档里;中文页的正文(重点整理 + 文字稿)在 src/content/videos-zh/ 同名的档里
const zhNotes = (await getCollection('videosZh')).find((x) => x.id === video.id);
const notes = astroLang === 'zh' ? zhNotes : video;
const { Content } = notes ? await render(notes) : { Content: null };
const hasNotes = !!notes?.body && notes.body.replace(/<!--[\s\S]*?-->/g, '').trim().length > 0;
// 文字稿原文(中文),放进结构化数据
const transcript = zhNotes?.body
  ? zhNotes.body.split(/^## 文字稿\s*$/m)[1]?.replace(/\s+/g, ' ').trim()
  : undefined;

const all = (await getCollection('videos'))
  .filter((v) => v.id !== video.id && v.data.category === video.data.category)
  .slice(0, 3);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const realYtId =
  video.data.platform === 'youtube' && video.data.videoId && !video.data.videoId.includes('TODO')
    ? video.data.videoId
    : null;
const thumbAbs = new URL(
  realYtId && video.data.thumbnail.startsWith('/images/placeholders/')
    ? `https://i.ytimg.com/vi/${realYtId}/hqdefault.jpg`
    : url(video.data.thumbnail),
  Astro.site,
).href;

const dateFmt = new Intl.DateTimeFormat(pick(lang, 'en-GB', 'zh-CN'), { dateStyle: 'long', timeZone: 'UTC' });
---

<BaseLayout
  title={title}
  description={blurb || pick(lang, `${title} — a Lawrence Law property know-how video, ${video.data.category} series.`, `${title} —— Lawrence Law 的买房短视频。`)}
  ogType="video.other"
  waMessage={waContextMessage(title, lang)}
>
  <JsonLd
    slot="head"
    data={videoSchema({
      name: title,
      description: blurb || title,
      thumbnailUrl: thumbAbs,
      uploadDate: video.data.publishDate,
      embedUrl: realYtId ? `https://www.youtube-nocookie.com/embed/${realYtId}` : undefined,
      contentUrl: video.data.videoUrl,
      transcript,
      spokenLanguage: transcript ? 'zh' : undefined,
    })}
  />
  <JsonLd
    slot="head"
    data={breadcrumbSchema([
      { name: pick(lang, 'Home', '首页'), url: new URL(href(lang, '/'), Astro.site).href },
      { name: pick(lang, 'Videos', '视频'), url: new URL(href(lang, '/videos/'), Astro.site).href },
      { name: title, url: canonical },
    ])}
  />

  <article class="container-site max-w-3xl py-10 sm:py-14">
    <nav class="mb-6 text-sm text-ink/60" aria-label="Breadcrumb">
      <a href={href(lang, '/videos/')} class="hover:text-gold-600">{pick(lang, 'Videos', '视频')}</a>
      <span class="mx-2">/</span>
      <span>{pick(lang, `${video.data.category} series`, `${catLabel}系列`)}</span>
    </nav>

    <h1 class="mb-1 text-2xl sm:text-3xl">{title}</h1>
    {!zh && video.data.titleZh && <p class="mb-4 text-base text-ink/55">{video.data.titleZh}</p>}
    <p class="mb-6 text-sm text-ink/50">
      {pick(lang, 'Published', '发布于')} {dateFmt.format(video.data.publishDate)}
      {video.data.longform && pick(lang, ' · In-depth long-form', ' · 长视频')}
    </p>

    <VideoEmbed
      platform={video.data.platform}
      videoId={video.data.videoId}
      videoUrl={video.data.videoUrl}
      title={title}
      thumbnail={video.data.thumbnail}
    />

    {blurb && <p class="mt-8 text-lg text-ink/80">{blurb}</p>}

    {hasNotes && Content && (
      <div class="prose-zh mt-8">
        <Content />
      </div>
    )}

    {/* 视频是用中文讲的:英文页连到中文原话,中文页连到英文翻译 */}
    {zhNotes && (
      <p class="mt-6 text-[15px] text-ink/70">
        {pick(lang, 'The video is in Mandarin. ', '')}
        <a href={zh ? url(`/videos/${video.id}/`) : url(`/zh/videos/${video.id}/`)} class="font-semibold text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4">
          {pick(lang, 'Read the original transcript in Chinese →', 'Read this in English →')}
        </a>
      </p>
    )}


    {all.length > 0 && (
      <div class="mt-14">
        <h2 class="mb-5 text-xl">{pick(lang, 'More in this series', '同系列的其他视频')}</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {all.map((v) => (
            <VideoCard
              slug={v.id}
              title={v.data.title}
              titleZh={v.data.titleZh}
              category={v.data.category}
              platform={v.data.platform}
              thumbnail={v.data.thumbnail}
              videoId={v.data.videoId}
              longform={v.data.longform}
            />
          ))}
        </div>
      </div>
    )}
  </article>

  <CTASection waMessage={waContextMessage(title, lang)} />
</BaseLayout>
