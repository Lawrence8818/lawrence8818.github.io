---
// Videos — 全部短视频直接嵌在这一页(原来的 Buyer Guide 页和 Videos 列表页合并成这一页;
// /buyerguide/ 现在转到这里)。Plain <iframe> embeds (no click-to-load script) so the players
// survive platforms that strip JS. 这个模板同时出英文页(/videos/)和中文页(/zh/videos/)。
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import MortgageCalculator from '../../components/MortgageCalculator.astro';
import JsonLd from '../../components/JsonLd.astro';
import { itemListSchema, breadcrumbSchema } from '../../lib/schema';
import { langOf, pick, href } from '../../i18n';
import { VIDEO_CATEGORY_ZH } from '../../i18n/videos';

const lang = langOf(Astro);
const zh = lang === 'zh';
const videos = (await getCollection('videos')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout
  title={pick(lang, 'Malaysia Property Videos: Watch First, Buy Smarter', '买房短视频：先看懂，再出手')}
  description={pick(
    lang,
    'Short, honest videos on buying property in Malaysia — bank approval vs affordability, RPGT, walkability, density and more. Watch first, buy smarter.',
    '马来西亚买房的实话短视频：银行批得到不等于买得起、RPGT、走路到不到 LRT、高密度的代价等等。先看懂，再出手。',
  )}
>
  <JsonLd
    slot="head"
    data={itemListSchema({
      url: canonical,
      name: pick(lang, 'Property videos by Lawrence Law', 'Lawrence Law 的买房短视频'),
      description: pick(lang, 'Short videos answering the questions Malaysian homebuyers ask most.', '回答马来西亚买家最常问的问题的短视频。'),
      lang,
      items: videos.map((v) => ({
        name: zh && v.data.titleZh ? v.data.titleZh : v.data.title,
        url: new URL(href(lang, `/videos/${v.id}/`), Astro.site).href,
      })),
    })}
  />
  <JsonLd
    slot="head"
    data={breadcrumbSchema([
      { name: pick(lang, 'Home', '首页'), url: new URL(href(lang, '/'), Astro.site).href },
      { name: pick(lang, 'Videos', '视频'), url: canonical },
    ])}
  />
  <section class="bg-navy-900 pt-14 pb-4 text-white sm:pt-20 sm:pb-6">
    <div class="container-site">
      <h1 class="mb-4 text-[32px] leading-tight text-white sm:text-5xl">{pick(lang, 'Videos', '视频')}</h1>
      <div class="mb-5 h-px w-16 bg-gold-500"></div>
      <p class="max-w-2xl text-[17px] leading-[1.8] text-navy-100">
        {pick(
          lang,
          'Watch first, buy smarter. Short, honest videos on the questions Malaysian homebuyers ask me most, so you can avoid the common pitfalls before you commit.',
          '先看懂，再出手。这些短视频回答的是马来西亚买家最常问我的问题，帮你在下决定之前避开常见的坑。',
        )}
      </p>
      <p class="mt-4 text-[15px] text-navy-100">
        {pick(lang, 'Prefer reading? ', '想看文字版？')}
        <a href={href(lang, '/guides/')} class="font-semibold text-gold-500 underline decoration-gold-500/50 underline-offset-4 hover:decoration-gold-500">
          {pick(lang, 'Read the buyer guides →', '看买房指南 →')}
        </a>
      </p>
    </div>
  </section>

  <section class="bg-navy-900 pt-8 pb-14 sm:pt-10 sm:pb-28">
    <div class="container-site">
      {/* Watch progress — filled in by the script below; hidden without JS */}
      <div id="vg-progress" class="mb-8 hidden max-w-md">
        <div class="mb-2 flex items-baseline justify-between">
          <span class="label-sm text-navy-100/80">{pick(lang, 'Your progress', '观看进度')}</span>
          <span class="label-sm text-gold-500"><span id="vg-count">0</span> / {videos.length} {pick(lang, 'watched', '已看')}</span>
        </div>
        <div class="h-1.5 overflow-hidden rounded-full bg-white/15">
          <div id="vg-bar" class="h-full w-0 rounded-full bg-gold-500 transition-all duration-700"></div>
        </div>
      </div>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {videos.map((v, i) => (
          <figure class="vg-card relative flex flex-col overflow-hidden rounded-[4px] bg-white/10 backdrop-blur-sm" data-vid={v.data.videoId}>
            <span class="vg-next label-sm absolute top-3 left-3 z-10 hidden rounded-full bg-gold-500 px-3 py-1 text-navy-900">{pick(lang, 'Up Next', '下一支')}</span>
            <span class="vg-done label-sm absolute top-3 right-3 z-10 hidden rounded-full bg-navy-950/85 px-3 py-1 text-gold-500">{pick(lang, '✓ Watched', '✓ 已看')}</span>
            <div class="aspect-[9/16] w-full flex-none bg-navy-950">
              <iframe
                src={`https://www.youtube.com/embed/${v.data.videoId}?enablejsapi=1`}
                title={zh && v.data.titleZh ? v.data.titleZh : v.data.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                class="h-full w-full border-0"
              ></iframe>
            </div>
            <figcaption class="flex flex-1 flex-col p-5">
              <span class="label-sm text-gold-500">
                {pick(lang, `Part ${i + 1} · ${v.data.category}`, `第 ${i + 1} 支 · ${VIDEO_CATEGORY_ZH[v.data.category] ?? v.data.category}`)}
              </span>
              <h2 class="mt-2 font-sans text-[17px] leading-snug font-bold">
                <a href={href(lang, `/videos/${v.id}/`)} class="text-white hover:text-gold-500">
                  {zh && v.data.titleZh ? v.data.titleZh : v.data.title}
                </a>
              </h2>
              <p class="mt-1 text-sm text-navy-100">{zh ? (v.data.descriptionZh ?? v.data.title) : v.data.titleZh}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <style is:global>
    /* Video cards: quiet motion only — hover lift on desktop, scroll-in fade
       where the browser supports it. The players themselves stay still. */
    .vg-card {
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        background-color 0.3s ease;
    }
    .vg-card:hover {
      transform: translateY(-4px);
      background-color: rgb(255 255 255 / 0.14);
      box-shadow: 0 14px 34px rgb(0 0 0 / 0.35);
    }
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .vg-card {
          animation: rise linear both;
          animation-timeline: view();
          animation-range: entry 0% entry 38%;
        }
        .vg-card:nth-child(3n + 2) {
          animation-range: entry 6% entry 44%;
        }
        .vg-card:nth-child(3n) {
          animation-range: entry 12% entry 50%;
        }
      }
    }
  </style>

  {/* 贷款计算器目前只有英文 */}
  {!zh && <MortgageCalculator tone="light" />}

  <CTASection
    heading={pick(lang, 'A question these videos didn’t answer?', '这些视频没回答到你的问题？')}
    sub={pick(lang, 'Message me directly — real person, real reply, no pressure.', '直接问我。本人回复，不催促。')}
    waMessage={pick(lang, 'Hi Lawrence, I watched your videos and have a question about buying property.', '你好 Lawrence，我看了你的视频，想问一个买房的问题。')}
  />

  <script is:inline>
    (function () {
      // Continuous watching: the YouTube embeds report state changes via
      // postMessage (enablejsapi=1). When a video ends we mark it watched
      // (persisted), update the progress bar, and guide the eye to the next
      // unwatched one with an "Up Next" badge + gentle scroll.
      var cards = Array.prototype.slice.call(document.querySelectorAll('.vg-card[data-vid]'));
      if (!cards.length) return;
      var KEY = 'llp-bg-watched';
      var watched;
      try { watched = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { watched = []; }

      var bar = document.getElementById('vg-bar');
      var count = document.getElementById('vg-count');
      var wrap = document.getElementById('vg-progress');
      if (wrap) wrap.classList.remove('hidden');

      function refresh(scrollToNext) {
        var next = null;
        cards.forEach(function (c) {
          var done = watched.indexOf(c.dataset.vid) !== -1;
          c.querySelector('.vg-done').classList.toggle('hidden', !done);
          if (!done && !next) next = c;
        });
        cards.forEach(function (c) {
          c.querySelector('.vg-next').classList.toggle('hidden', c !== next || watched.length === 0);
        });
        if (count) count.textContent = String(watched.length);
        if (bar) bar.style.width = Math.round((watched.length / cards.length) * 100) + '%';
        if (scrollToNext && next && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          next.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }

      function markWatched(vid) {
        if (watched.indexOf(vid) === -1) {
          watched.push(vid);
          try { localStorage.setItem(KEY, JSON.stringify(watched)); } catch (e) {}
          refresh(true);
        }
      }

      // handshake so each player starts posting events
      cards.forEach(function (c) {
        var f = c.querySelector('iframe');
        var hello = function () {
          try {
            f.contentWindow.postMessage(JSON.stringify({ event: 'listening', id: c.dataset.vid, channel: 'widget' }), '*');
          } catch (e) {}
        };
        f.addEventListener('load', hello);
        hello();
      });

      window.addEventListener('message', function (e) {
        if (typeof e.data !== 'string' || e.origin.indexOf('youtube.com') === -1) return;
        var d;
        try { d = JSON.parse(e.data); } catch (err) { return; }
        var state =
          d.event === 'onStateChange' ? d.info :
          d.event === 'infoDelivery' && d.info && typeof d.info.playerState === 'number' ? d.info.playerState : null;
        if (state !== 0) return; // 0 = ended
        var card = cards.find
          ? cards.find(function (c) { return c.querySelector('iframe').contentWindow === e.source; })
          : null;
        if (card) markWatched(card.dataset.vid);
      });

      refresh(false);
    })();
  </script>
</BaseLayout>
