---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import JsonLd from '../../components/JsonLd.astro';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';
import { url } from '../../lib/url';
import { waContextMessage } from '../../lib/whatsapp';
import { instalmentDisplay, monthlyNumber } from '../../lib/property-facts';
import { isComparePage, inCompareArea } from '../../lib/areas';

export async function getStaticPaths() {
  const areas = await getCollection('areas');
  return areas.map((a) => ({ params: { slug: a.id }, props: { area: a } }));
}

const { area } = Astro.props;
const { Content } = await render(area);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const waMsg = waContextMessage(`buying property in ${area.data.name}`);

// 这一区在售的全部项目(KLCC 归在 Kuala Lumpur 这一页)
const REGIONS_OF: Record<string, string[]> = {
  kl: ['kuala-lumpur', 'klcc'],
  'petaling-jaya': ['petaling-jaya'],
  selangor: ['selangor'],
  johor: ['johor'],
  penang: ['penang'],
};
// 对比页用地段的名字来写句子;一般区域页这个值是空的
const loc = isComparePage(area.data) ? area.data.name : undefined;
const inArea = (p: { data: { location: string; region?: string } }) =>
  loc ? inCompareArea(area.data, p) : (REGIONS_OF[area.id] ?? []).includes(p.data.region ?? '');
const allInArea = (await getCollection('properties')).filter(inArea);
// 已售完的项目不出现在这一页
const areaProjects = allInArea
  .filter((p) => !p.data.soldOut)
  .sort((a, b) =>
    loc
      ? (monthlyNumber(a.data.monthly) ?? Infinity) - (monthlyNumber(b.data.monthly) ?? Infinity)
      : a.data.order - b.data.order,
  );

// ---- 地段页(例如 Bukit Jalil):从项目资料自动算出的几个事实,资料变了这里跟着变 ----
const list = (names: string[]) => new Intl.ListFormat('en', { type: 'conjunction' }).format(names);
const sizeNums = (s?: string) =>
  ((s || '').match(/[\d,]+/g) || []).map((n) => parseInt(n.replace(/,/g, ''), 10)).filter((n) => n > 0);
/** "Q2 2027" / "Feb 2028" / "2029" → 可以比较先后的数字;认不出就排最后 */
const whenNum = (c: string) => {
  const y = +(c.match(/20\d\d/) || [])[0];
  if (!y) return Infinity;
  const q = c.match(/Q([1-4])/i);
  const m = c.match(/jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec/i);
  const mi = m ? 'janfebmaraprmayjunjulaugsepoctnovdec'.indexOf(m[0].toLowerCase()) / 3 : -1;
  return y + (q ? (+q[1] * 3 - 1) / 12 : mi >= 0 ? mi / 12 : 0.99);
};
const withMonthly = areaProjects.filter((p) => monthlyNumber(p.data.monthly));
const lowest = withMonthly.length ? Math.min(...withMonthly.map((p) => monthlyNumber(p.data.monthly)!)) : 0;
const cheapest = withMonthly.filter((p) => monthlyNumber(p.data.monthly) === lowest);
const freehold = areaProjects.filter((p) => /freehold/i.test(p.data.tenure));
const leasehold = areaProjects.filter((p) => /lease/i.test(p.data.tenure));
const completed = areaProjects.filter((p) => /completed/i.test(p.data.completion));
// 预计完工日期已经过了、但资料还没改成 Completed 的,不拿来回答「哪个最先完工」
const today = new Date();
const nowNum = today.getUTCFullYear() + today.getUTCMonth() / 12;
const soonest = areaProjects
  .filter((p) => !/completed/i.test(p.data.completion) && whenNum(p.data.completion) >= nowNum)
  .sort((a, b) => whenNum(a.data.completion) - whenNum(b.data.completion))[0];
const noFigure = areaProjects.length - withMonthly.length;
// 同一页里地点不止一种写法时(例如 Bangsar 和 Bangsar South),表里多出一栏地点
const mixedPlaces = new Set(areaProjects.map((p) => p.data.location)).size > 1;
const largest = [...areaProjects].sort(
  (a, b) => Math.max(0, ...sizeNums(b.data.layoutSize)) - Math.max(0, ...sizeNums(a.data.layoutSize)),
)[0];
const autoFaqs = loc && areaProjects.length
  ? [
      {
        question: `How many projects do you cover in ${loc}?`,
        answer: `I currently cover ${areaProjects.length} projects in ${loc} that still have units available: ${list(areaProjects.map((p) => p.data.name))}.`,
      },
      ...(cheapest.length
        ? [{
            question: `Which project in ${loc} has the lowest monthly instalment?`,
            answer: `${list(cheapest.map((p) => p.data.name))} ${cheapest.length > 1 ? 'have' : 'has'} the lowest estimated monthly instalment among the projects I cover in ${loc}, from about ${cheapest[0].data.monthly} a month.${noFigure ? ` ${noFigure} of the ${areaProjects.length} projects do not have a published estimate yet, so ask me for those.` : ''} Instalment figures are estimates and depend on your loan margin, tenure and interest rate.`,
          }]
        : []),
      ...(freehold.length
        ? [{
            question: `Which projects in ${loc} are freehold?`,
            answer: `${list(freehold.map((p) => p.data.name))} ${freehold.length > 1 ? 'are' : 'is'} freehold.${leasehold.length ? ` ${list(leasehold.map((p) => p.data.name))} ${leasehold.length > 1 ? 'are' : 'is'} leasehold.` : ''}`,
          }]
        : []),
      ...(completed.length
        ? [{
            question: `Which ${loc} projects are already completed?`,
            answer: `${list(completed.map((p) => p.data.name))} ${completed.length > 1 ? 'are' : 'is'} already completed, so you can see the actual building before you decide.${soonest ? ` Among those still under construction, ${soonest.data.name} is expected first: ${soonest.data.completion}.` : ''}`,
          }]
        : soonest
        ? [{
            question: `Which ${loc} project will be completed first?`,
            answer: `${soonest.data.name} has the earliest expected completion among the projects I cover in ${loc}: ${soonest.data.completion}. Completion dates are the developers' estimates and can change.`,
          }]
        : []),
      ...(largest && largest.data.layoutSize
        ? [{
            question: `Which ${loc} project has the largest layouts?`,
            answer: `${largest.data.name} offers the largest layouts among the projects I cover in ${loc}, with units of ${largest.data.layoutSize.replace(/sf/, 'sq ft')}.`,
          }]
        : []),
    ]
  : [];
const pageFaqs = [...autoFaqs, ...(area.data.faqs ?? [])];
const n = String(areaProjects.length);
const pageTitle = loc
  ? (area.data.compareTitle ?? `${loc} New Launches: {n} Projects Compared`).replace('{n}', n)
  : `Buying Property in ${area.data.name} — New-Launch Advice`;
const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={pageTitle}
  description={area.data.intro}
  waMessage={waMsg}
>
  <JsonLd
    slot="head"
    data={breadcrumbSchema([
      { name: 'Home', url: new URL(url('/'), Astro.site).href },
      { name: 'Areas', url: new URL(url('/areas/'), Astro.site).href },
      { name: area.data.name, url: canonical },
    ])}
  />
  {loc && areaProjects.length > 0 && (
    <JsonLd
      slot="head"
      data={itemListSchema({
        url: canonical,
        name: `New-launch projects in ${loc}`,
        description: area.data.intro,
        items: areaProjects.map((p) => ({
          name: p.data.name,
          url: new URL(url(`/properties/${p.id}/`), Astro.site).href,
        })),
      })}
    />
  )}

  <section class="relative bg-navy-950 text-white">
    {/* 占位图上有「待替换」字样,不拿来当背景;换成真照片后才显示 */}
    {!area.data.heroImage.includes('/placeholders/') && (
      <img
        src={url(area.data.heroImage)}
        alt={`${area.data.name} property`}
        class="absolute inset-0 h-full w-full object-cover opacity-30"
      />
    )}
    <div class="container-site relative py-16 sm:py-20">
      <nav class="mb-4 text-sm text-navy-100/80" aria-label="Breadcrumb">
        <a href={url('/areas/')} class="hover:text-gold-500">Areas</a>
        <span class="mx-2">/</span>
        <span>{area.data.name}</span>
      </nav>
      <p class="font-display text-sm tracking-widest text-gold-500 uppercase">Coverage</p>
      <h1 class="mt-1 text-3xl text-white sm:text-4xl">{loc ? (area.data.compareHeading ?? `New Launches in ${loc}, Compared`).replace('{n}', n) : `Buying in ${area.data.name}? Talk to Lawrence`}</h1>
      <p class="mt-4 max-w-2xl text-lg text-navy-100">{area.data.intro}</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {area.data.highlights.map((h) => (
          <li class="rounded-full border border-gold-500/50 px-3 py-1 text-sm text-gold-100">{h}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-12">
    <div class="container-site max-w-3xl">
      {loc && areaProjects.length > 0 && (
        <div class="mb-12">
          <h2 class="mb-2 text-xl sm:text-2xl">{areaProjects.length} projects in {loc}, side by side</h2>
          <p class="mb-5 text-[15px] text-ink/70">
            Sorted from the lowest estimated monthly instalment, with size range, tenure and expected completion. Tap a project for its layouts and common questions.
          </p>
          {/* 手机:一个项目一格,不用左右滑 */}
          <ul class="divide-y divide-border rounded-[4px] border border-border bg-white sm:hidden">
            {areaProjects.map((p) => (
              <li>
                <a href={url(`/properties/${p.id}/`)} class="block px-4 py-3">
                  <span class="flex items-baseline justify-between gap-3">
                    <span class="font-semibold text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4">{p.data.name}</span>
                    <span class="flex-none font-semibold text-navy-900">{instalmentDisplay(p.data).text}</span>
                  </span>
                  <span class="mt-1 block text-sm text-ink/70">
                    {[mixedPlaces ? p.data.location : '', p.data.layoutSize, p.data.tenure, p.data.completion].filter(Boolean).join(' · ')}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <div class="hidden overflow-x-auto rounded-[4px] border border-border sm:block">
            <table class="w-full min-w-[600px] border-collapse text-left text-[15px]">
              <thead class="bg-navy-900 text-white">
                <tr>
                  <th scope="col" class="px-4 py-3 font-semibold">Project</th>
                  <th scope="col" class="px-4 py-3 font-semibold">Monthly from</th>
                  <th scope="col" class="px-4 py-3 font-semibold">Sizes</th>
                  <th scope="col" class="px-4 py-3 font-semibold">Tenure</th>
                  <th scope="col" class="px-4 py-3 font-semibold">Completion</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border bg-white">
                {areaProjects.map((p) => {
                  const i = instalmentDisplay(p.data);
                  return (
                    <tr>
                      <th scope="row" class="px-4 py-3 font-semibold">
                        <a href={url(`/properties/${p.id}/`)} class="text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4 hover:text-gold-600">{p.data.name}</a>
                        {mixedPlaces && <span class="mt-0.5 block text-[13px] font-normal text-ink/60">{p.data.location}</span>}
                      </th>
                      <td class="px-4 py-3 font-semibold whitespace-nowrap text-navy-900">{i.text}</td>
                      <td class="px-4 py-3 whitespace-nowrap">{p.data.layoutSize ?? '—'}</td>
                      <td class="px-4 py-3">{p.data.tenure}</td>
                      <td class="px-4 py-3 whitespace-nowrap">{p.data.completion}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <p class="mt-3 text-[13px] text-ink/60">
            Instalments are estimates; sizes in square feet.
          </p>
        </div>
      )}

      <div class="prose-zh">
        <Content />
      </div>

      {area.data.hotProjects && area.data.hotProjects.length > 0 && (
        <div class="mt-12">
          <h2 class="mb-5 text-xl sm:text-2xl">Projects worth watching</h2>
          <div class="space-y-3">
            {area.data.hotProjects.map((p) => (
              <div class="card flex flex-wrap items-baseline justify-between gap-2">
                <div>
                  <p class="font-semibold text-navy-900">{p.name}</p>
                  <p class="text-sm text-ink/70">{p.type}{p.note && ` · ${p.note}`}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {!loc && areaProjects.length > 0 && (
        <div class="mt-12">
          <h2 class="mb-2 text-xl sm:text-2xl">All {areaProjects.length} projects I cover in {area.data.name}</h2>
          <p class="mb-5 text-[15px] text-ink/70">
            Monthly instalments are estimates. Open any project for its layouts, tenure, completion date and common questions.
          </p>
          <ul class="divide-y divide-border border-y border-border">
            {areaProjects.map((p) => {
              const i = instalmentDisplay(p.data);
              return (
                <li>
                  <a href={url(`/properties/${p.id}/`)} class="group flex min-h-14 flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 py-3">
                    <span>
                      <span class="font-semibold text-navy-900 group-hover:text-gold-600">{p.data.name}</span>
                      <span class="text-sm text-ink/60"> · {p.data.location}</span>
                    </span>
                    <span class="text-sm font-semibold text-navy-900">{i.amount ? `From ${i.text}/mo` : i.text}</span>
                  </a>
                </li>
              );
            })}
          </ul>
          <p class="mt-5">
            <a href={`${url('/allproperties/')}?region=${(REGIONS_OF[area.id] ?? [])[0]}`} class="font-semibold text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4">
              Filter these by size and monthly instalment →
            </a>
          </p>
        </div>
      )}

      <div class="mt-12">
        <h2 class="mb-4 text-xl sm:text-2xl">Guides worth reading first</h2>
        <ul class="divide-y divide-border border-y border-border">
          {guides.map((g) => (
            <li>
              <a href={url(`/guides/${g.id}/`)} class="group flex min-h-14 items-center justify-between gap-4 py-3 font-semibold text-navy-900 hover:text-gold-600">
                <span>{g.data.title}</span>
                <span class="flex-none text-gold-500" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {pageFaqs.length > 0 && (
        <div class="mt-12">
          <FAQ faqs={pageFaqs} heading={`Common questions about buying in ${area.data.name}`} />
        </div>
      )}
    </div>
  </section>

  <CTASection
    heading={loc ? `Not sure which ${loc} project fits?` : `Want to see projects in ${area.data.name}?`}
    sub="Tell me your budget and needs, and I’ll pull together the projects worth viewing here, then arrange a focused day of viewings."
    waMessage={waMsg}
  />
</BaseLayout>
