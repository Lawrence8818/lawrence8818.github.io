---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import JsonLd from '../../components/JsonLd.astro';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';
import { url } from '../../lib/url';
import { waContextMessage } from '../../lib/whatsapp';
import { instalmentDisplay, instalmentDisplayZh, monthlyNumber, tenureZh, completionZh, sizeZh } from '../../lib/property-facts';
import { langOf, pick, href } from '../../i18n';
import { isComparePage, inCompareArea } from '../../lib/areas';

export async function getStaticPaths() {
  const areas = await getCollection('areas');
  return areas.map((a) => ({ params: { slug: a.id }, props: { area: a } }));
}

const { area } = Astro.props;
// 这个模板同时出英文页(/areas/…)和中文页(/zh/areas/…)。
// 中文页的文字来自 src/content/areas-zh/ 里同名的文件;取项目的规则(locality 等)一律看英文档。
const lang = langOf(Astro);
const zh = lang === 'zh';
const zhEntry = zh ? (await getCollection('areasZh')).find((a) => a.id === area.id) : undefined;
const text = zhEntry ?? area;
const T = text.data;
const { Content } = await render(text);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const waMsg = waContextMessage(pick(lang, `buying property in ${area.data.name}`, `在 ${area.data.name} 买房`), lang);
// 项目资料在两种语言下的写法
const inst = (d: { monthly?: string; soldOut?: boolean }) => (zh ? instalmentDisplayZh(d) : instalmentDisplay(d));
const tenureOf = (t: string) => (zh ? tenureZh(t) : t);
const doneOf = (c: string) => (zh ? completionZh(c) : c);
const sizeOf = (x?: string) => (x ? (zh ? sizeZh(x) : x) : '—');

// 这一区在售的全部项目(KLCC 归在 Kuala Lumpur 这一页)
const REGIONS_OF: Record<string, string[]> = {
  kl: ['kuala-lumpur', 'klcc'],
  'petaling-jaya': ['petaling-jaya'],
  selangor: ['selangor'],
  johor: ['johor'],
  penang: ['penang'],
};
// 对比页用地段的名字来写句子;一般区域页这个值是空的
const loc = isComparePage(area.data) ? area.data.name : undefined;
const inArea = (p: { data: { location: string; region?: string } }) =>
  loc ? inCompareArea(area.data, p) : (REGIONS_OF[area.id] ?? []).includes(p.data.region ?? '');
const allInArea = (await getCollection('properties')).filter(inArea);
// 已售完的项目不出现在这一页
const areaProjects = allInArea
  .filter((p) => !p.data.soldOut)
  .sort((a, b) =>
    loc
      ? (monthlyNumber(a.data.monthly) ?? Infinity) - (monthlyNumber(b.data.monthly) ?? Infinity)
      : a.data.order - b.data.order,
  );

// ---- 地段页(例如 Bukit Jalil):从项目资料自动算出的几个事实,资料变了这里跟着变 ----
const list = (names: string[]) =>
  zh ? names.join('、') : new Intl.ListFormat('en', { type: 'conjunction' }).format(names);
const sizeNums = (s?: string) =>
  ((s || '').match(/[\d,]+/g) || []).map((n) => parseInt(n.replace(/,/g, ''), 10)).filter((n) => n > 0);
/** "Q2 2027" / "Feb 2028" / "2029" → 可以比较先后的数字;认不出就排最后 */
const whenNum = (c: string) => {
  const y = +(c.match(/20\d\d/) || [])[0];
  if (!y) return Infinity;
  const q = c.match(/Q([1-4])/i);
  const m = c.match(/jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec/i);
  const mi = m ? 'janfebmaraprmayjunjulaugsepoctnovdec'.indexOf(m[0].toLowerCase()) / 3 : -1;
  return y + (q ? (+q[1] * 3 - 1) / 12 : mi >= 0 ? mi / 12 : 0.99);
};
const withMonthly = areaProjects.filter((p) => monthlyNumber(p.data.monthly));
const lowest = withMonthly.length ? Math.min(...withMonthly.map((p) => monthlyNumber(p.data.monthly)!)) : 0;
const cheapest = withMonthly.filter((p) => monthlyNumber(p.data.monthly) === lowest);
const freehold = areaProjects.filter((p) => /freehold/i.test(p.data.tenure));
const leasehold = areaProjects.filter((p) => /lease/i.test(p.data.tenure));
const completed = areaProjects.filter((p) => /completed/i.test(p.data.completion));
// 预计完工日期已经过了、但资料还没改成 Completed 的,不拿来回答「哪个最先完工」
const today = new Date();
const nowNum = today.getUTCFullYear() + today.getUTCMonth() / 12;
const soonest = areaProjects
  .filter((p) => !/completed/i.test(p.data.completion) && whenNum(p.data.completion) >= nowNum)
  .sort((a, b) => whenNum(a.data.completion) - whenNum(b.data.completion))[0];
const noFigure = areaProjects.length - withMonthly.length;
// 同一页里地点不止一种写法时(例如 Bangsar 和 Bangsar South),表里多出一栏地点
const mixedPlaces = new Set(areaProjects.map((p) => p.data.location)).size > 1;
const largest = [...areaProjects].sort(
  (a, b) => Math.max(0, ...sizeNums(b.data.layoutSize)) - Math.max(0, ...sizeNums(a.data.layoutSize)),
)[0];
const autoFaqsEn = loc && areaProjects.length
  ? [
      {
        question: `How many projects do you cover in ${loc}?`,
        answer: `I currently cover ${areaProjects.length} projects in ${loc} that still have units available: ${list(areaProjects.map((p) => p.data.name))}.`,
      },
      ...(cheapest.length
        ? [{
            question: `Which project in ${loc} has the lowest monthly instalment?`,
            answer: `${list(cheapest.map((p) => p.data.name))} ${cheapest.length > 1 ? 'have' : 'has'} the lowest estimated monthly instalment among the projects I cover in ${loc}, from about ${cheapest[0].data.monthly} a month.${noFigure ? ` ${noFigure} of the ${areaProjects.length} projects do not have a published estimate yet, so ask me for those.` : ''} Instalment figures are estimates and depend on your loan margin, tenure and interest rate.`,
          }]
        : []),
      ...(freehold.length
        ? [{
            question: `Which projects in ${loc} are freehold?`,
            answer: `${list(freehold.map((p) => p.data.name))} ${freehold.length > 1 ? 'are' : 'is'} freehold.${leasehold.length ? ` ${list(leasehold.map((p) => p.data.name))} ${leasehold.length > 1 ? 'are' : 'is'} leasehold.` : ''}`,
          }]
        : []),
      ...(completed.length
        ? [{
            question: `Which ${loc} projects are already completed?`,
            answer: `${list(completed.map((p) => p.data.name))} ${completed.length > 1 ? 'are' : 'is'} already completed, so you can see the actual building before you decide.${soonest ? ` Among those still under construction, ${soonest.data.name} is expected first: ${soonest.data.completion}.` : ''}`,
          }]
        : soonest
        ? [{
            question: `Which ${loc} project will be completed first?`,
            answer: `${soonest.data.name} has the earliest expected completion among the projects I cover in ${loc}: ${soonest.data.completion}. Completion dates are the developers' estimates and can change.`,
          }]
        : []),
      ...(largest && largest.data.layoutSize
        ? [{
            question: `Which ${loc} project has the largest layouts?`,
            answer: `${largest.data.name} offers the largest layouts among the projects I cover in ${loc}, with units of ${largest.data.layoutSize.replace(/sf/, 'sq ft')}.`,
          }]
        : []),
    ]
  : [];
const autoFaqsZh = loc && areaProjects.length
  ? [
      {
        question: `${loc} 你负责几个项目？`,
        answer: `我目前在 ${loc} 负责 ${areaProjects.length} 个还有单位的项目：${list(areaProjects.map((p) => p.data.name))}。`,
      },
      ...(cheapest.length
        ? [{
            question: `${loc} 哪个项目的月供最低？`,
            answer: `在我负责的 ${loc} 项目里，${list(cheapest.map((p) => p.data.name))} 的预估月供最低，每月约 ${cheapest[0].data.monthly} 起。${noFigure ? `${areaProjects.length} 个项目里有 ${noFigure} 个还没有公布估算，这几个请直接问我。` : ''}月供是估算数字，实际要看你的贷款成数、年限和利率。`,
          }]
        : []),
      ...(freehold.length
        ? [{
            question: `${loc} 哪些项目是永久地契？`,
            answer: `${list(freehold.map((p) => p.data.name))} 是永久地契。${leasehold.length ? `${list(leasehold.map((p) => p.data.name))} 是租赁地契。` : ''}`,
          }]
        : []),
      ...(completed.length
        ? [{
            question: `${loc} 哪些项目已经建好？`,
            answer: `${list(completed.map((p) => p.data.name))} 已经建好，下决定之前可以先看实际的建筑。${soonest ? `还在建的项目里，${soonest.data.name} 预计最先完工：${completionZh(soonest.data.completion)}。` : ''}`,
          }]
        : soonest
        ? [{
            question: `${loc} 哪个项目最先完工？`,
            answer: `在我负责的 ${loc} 项目里，${soonest.data.name} 预计最早完工：${completionZh(soonest.data.completion)}。完工日期是发展商的预估，可能会调整。`,
          }]
        : []),
      ...(largest && largest.data.layoutSize
        ? [{
            question: `${loc} 哪个项目的户型最大？`,
            answer: `在我负责的 ${loc} 项目里，${largest.data.name} 的户型最大，单位面积 ${sizeZh(largest.data.layoutSize)}。`,
          }]
        : []),
    ]
  : [];
const autoFaqs = zh ? autoFaqsZh : autoFaqsEn;
const pageFaqs = [...autoFaqs, ...(T.faqs ?? [])];
const n = String(areaProjects.length);
const pageTitle = loc
  ? (T.compareTitle ?? pick(lang, `${loc} New Launches: {n} Projects Compared`, `${loc} 新盘：{n} 个项目对比`)).replace('{n}', n)
  : pick(lang, `Buying Property in ${area.data.name} — New-Launch Advice`, `在 ${area.data.name} 买房 — 新盘建议`);
const guides = (await getCollection(zh ? 'guidesZh' : 'guides', ({ data }) => !data.draft))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={pageTitle}
  description={T.intro}
  waMessage={waMsg}
>
  <JsonLd
    slot="head"
    data={breadcrumbSchema([
      { name: pick(lang, 'Home', '首页'), url: new URL(href(lang, '/'), Astro.site).href },
      { name: pick(lang, 'Areas', '区域'), url: new URL(href(lang, '/areas/'), Astro.site).href },
      { name: area.data.name, url: canonical },
    ])}
  />
  {loc && areaProjects.length > 0 && (
    <JsonLd
      slot="head"
      data={itemListSchema({
        url: canonical,
        name: pick(lang, `New-launch projects in ${loc}`, `${loc} 的新盘项目`),
        description: T.intro,
        lang,
        items: areaProjects.map((p) => ({
          name: p.data.name,
          url: new URL(href(lang, `/properties/${p.id}/`), Astro.site).href,
        })),
      })}
    />
  )}

  <section class="relative bg-navy-950 text-white">
    {/* 占位图上有「待替换」字样,不拿来当背景;换成真照片后才显示 */}
    {!area.data.heroImage.includes('/placeholders/') && (
      <img
        src={url(area.data.heroImage)}
        alt={pick(lang, `${area.data.name} property`, `${area.data.name} 房产`)}
        class="absolute inset-0 h-full w-full object-cover opacity-30"
      />
    )}
    <div class="container-site relative py-16 sm:py-20">
      <nav class="mb-4 text-sm text-navy-100/80" aria-label="Breadcrumb">
        <a href={href(lang, '/areas/')} class="hover:text-gold-500">{pick(lang, 'Areas', '区域')}</a>
        <span class="mx-2">/</span>
        <span>{area.data.name}</span>
      </nav>
      <p class="font-display text-sm tracking-widest text-gold-500 uppercase">{pick(lang, 'Coverage', '服务地区')}</p>
      <h1 class="mt-1 text-3xl text-white sm:text-4xl">{loc ? (T.compareHeading ?? pick(lang, `New Launches in ${loc}, Compared`, `${loc} 新盘对比`)).replace('{n}', n) : pick(lang, `Buying in ${area.data.name}? Talk to Lawrence`, `想在 ${area.data.name} 买房？和 Lawrence 聊聊`)}</h1>
      <p class="mt-4 max-w-2xl text-lg text-navy-100">{T.intro}</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {T.highlights.map((h) => (
          <li class="rounded-full border border-gold-500/50 px-3 py-1 text-sm text-gold-100">{h}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-12">
    <div class="container-site max-w-3xl">
      {loc && areaProjects.length > 0 && (
        <div class="mb-12">
          <h2 class="mb-2 text-xl sm:text-2xl">{pick(lang, `${areaProjects.length} projects in ${loc}, side by side`, `${loc} 的 ${areaProjects.length} 个项目，并排比较`)}</h2>
          <p class="mb-5 text-[15px] text-ink/70">
            {pick(lang, 'Sorted from the lowest estimated monthly instalment, with size range, tenure and expected completion. Tap a project for its layouts and common questions.', '按预估月供从低到高排，列出面积、地契和预计完工时间。点项目名称可以看户型和常见问题。')}
          </p>
          {/* 手机:一个项目一格,不用左右滑 */}
          <ul class="divide-y divide-border rounded-[4px] border border-border bg-white sm:hidden">
            {areaProjects.map((p) => (
              <li>
                <a href={href(lang, `/properties/${p.id}/`)} class="block px-4 py-3">
                  <span class="flex items-baseline justify-between gap-3">
                    <span class="font-semibold text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4">{p.data.name}</span>
                    <span class="flex-none font-semibold text-navy-900">{inst(p.data).text}</span>
                  </span>
                  <span class="mt-1 block text-sm text-ink/70">
                    {[mixedPlaces ? p.data.location : '', p.data.layoutSize ? sizeOf(p.data.layoutSize) : '', tenureOf(p.data.tenure), doneOf(p.data.completion)].filter(Boolean).join(' · ')}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <div class="hidden overflow-x-auto rounded-[4px] border border-border sm:block">
            <table class="w-full min-w-[600px] border-collapse text-left text-[15px]">
              <thead class="bg-navy-900 text-white">
                <tr>
                  <th scope="col" class="px-4 py-3 font-semibold">{pick(lang, 'Project', '项目')}</th>
                  <th scope="col" class="px-4 py-3 font-semibold">{pick(lang, 'Monthly from', '月供（起）')}</th>
                  <th scope="col" class="px-4 py-3 font-semibold">{pick(lang, 'Sizes', '面积')}</th>
                  <th scope="col" class="px-4 py-3 font-semibold">{pick(lang, 'Tenure', '地契')}</th>
                  <th scope="col" class="px-4 py-3 font-semibold">{pick(lang, 'Completion', '完工')}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border bg-white">
                {areaProjects.map((p) => {
                  const i = inst(p.data);
                  return (
                    <tr>
                      <th scope="row" class="px-4 py-3 font-semibold">
                        <a href={href(lang, `/properties/${p.id}/`)} class="text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4 hover:text-gold-600">{p.data.name}</a>
                        {mixedPlaces && <span class="mt-0.5 block text-[13px] font-normal text-ink/60">{p.data.location}</span>}
                      </th>
                      <td class="px-4 py-3 font-semibold whitespace-nowrap text-navy-900">{i.text}</td>
                      <td class="px-4 py-3 whitespace-nowrap">{sizeOf(p.data.layoutSize)}</td>
                      <td class="px-4 py-3">{tenureOf(p.data.tenure)}</td>
                      <td class="px-4 py-3 whitespace-nowrap">{doneOf(p.data.completion)}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <p class="mt-3 text-[13px] text-ink/60">
            {pick(lang, 'Instalments are estimates; sizes in square feet.', '月供为估算数字。')}
          </p>
        </div>
      )}

      <div class="prose-zh">
        <Content />
      </div>

      {T.hotProjects && T.hotProjects.length > 0 && (
        <div class="mt-12">
          <h2 class="mb-5 text-xl sm:text-2xl">{pick(lang, 'Projects worth watching', '值得留意的项目')}</h2>
          <div class="space-y-3">
            {T.hotProjects.map((p) => (
              <div class="card flex flex-wrap items-baseline justify-between gap-2">
                <div>
                  <p class="font-semibold text-navy-900">{p.name}</p>
                  <p class="text-sm text-ink/70">{p.type}{p.note && ` · ${p.note}`}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {!loc && areaProjects.length > 0 && (
        <div class="mt-12">
          <h2 class="mb-2 text-xl sm:text-2xl">{pick(lang, `All ${areaProjects.length} projects I cover in ${area.data.name}`, `${area.data.name} 我负责的全部 ${areaProjects.length} 个项目`)}</h2>
          <p class="mb-5 text-[15px] text-ink/70">
            {pick(lang, 'Monthly instalments are estimates. Open any project for its layouts, tenure, completion date and common questions.', '月供为估算数字。点开任何一个项目，可以看户型、地契、完工日期和常见问题。')}
          </p>
          <ul class="divide-y divide-border border-y border-border">
            {areaProjects.map((p) => {
              const i = inst(p.data);
              return (
                <li>
                  <a href={href(lang, `/properties/${p.id}/`)} class="group flex min-h-14 flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 py-3">
                    <span>
                      <span class="font-semibold text-navy-900 group-hover:text-gold-600">{p.data.name}</span>
                      <span class="text-sm text-ink/60"> · {p.data.location}</span>
                    </span>
                    <span class="text-sm font-semibold text-navy-900">{i.amount ? pick(lang, `From ${i.text}/mo`, `月供 ${i.text} 起`) : i.text}</span>
                  </a>
                </li>
              );
            })}
          </ul>
          <p class="mt-5">
            <a href={`${href(lang, '/allproperties/')}?region=${(REGIONS_OF[area.id] ?? [])[0]}`} class="font-semibold text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4">
              {pick(lang, 'Filter these by size and monthly instalment →', '按面积和月供筛选这些项目 →')}
            </a>
          </p>
        </div>
      )}

      <div class="mt-12">
        <h2 class="mb-4 text-xl sm:text-2xl">{pick(lang, 'Guides worth reading first', '先读这几篇指南')}</h2>
        <ul class="divide-y divide-border border-y border-border">
          {guides.map((g) => (
            <li>
              <a href={href(lang, `/guides/${g.id}/`)} class="group flex min-h-14 items-center justify-between gap-4 py-3 font-semibold text-navy-900 hover:text-gold-600">
                <span>{g.data.title}</span>
                <span class="flex-none text-gold-500" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {pageFaqs.length > 0 && (
        <div class="mt-12">
          <FAQ faqs={pageFaqs} heading={pick(lang, `Common questions about buying in ${area.data.name}`, `在 ${area.data.name} 买房的常见问题`)} />
        </div>
      )}
    </div>
  </section>

  <CTASection
    heading={loc ? pick(lang, `Not sure which ${loc} project fits?`, `不确定 ${loc} 哪个项目适合你？`) : pick(lang, `Want to see projects in ${area.data.name}?`, `想看 ${area.data.name} 的项目？`)}
    sub={pick(lang, 'Tell me your budget and needs, and I’ll pull together the projects worth viewing here, then arrange a focused day of viewings.', '告诉我你的预算和需求，我把这一区值得看的项目整理出来，再安排一天集中看房。')}
    waMessage={waMsg}
  />
</BaseLayout>
