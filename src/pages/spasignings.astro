---
// Client Stories. The stories themselves live in src/data/client-stories.ts
// (shared with llms.txt), in an intentional display order.
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import StarRating from '../components/StarRating.astro';
import JsonLd from '../components/JsonLd.astro';
import { url } from '../lib/url';
import { STORIES } from '../data/client-stories';
import { breadcrumbSchema, clientStoriesSchema } from '../lib/schema';

const siteUrl = Astro.site?.href ?? 'https://www.lawrencelawproperty.com/';
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Auto-scrolling filmstrip shows every signing photo, tripled for a seamless
// loop that stays full across the whole width.
const FILMSTRIP = STORIES.filter((s) => s.image);

// Split into masonry blocks with a gold pull-quote band between them
// One continuous masonry (no section breaks) keeps the columns balanced so
// there are no misleading white gaps mid-scroll. Gold quote tiles are woven
// into the same flow at intervals for rhythm.
const QUOTES = [
  '“Knowing what I wanted was half the battle — seeing the full comparison won the other half.”',
  '“Some homes are worth waiting fifty years for.”',
  '“Sometimes it’s not about whether you qualify — it’s about how your case is presented.”',
];
const QUOTE_AFTER: Record<number, string> = { 8: QUOTES[0], 17: QUOTES[1], 26: QUOTES[2] };
const ITEMS: Array<{ kind: 'story'; data: (typeof STORIES)[number] } | { kind: 'quote'; text: string }> = [];
STORIES.forEach((s, i) => {
  ITEMS.push({ kind: 'story', data: s });
  if (QUOTE_AFTER[i]) ITEMS.push({ kind: 'quote', text: QUOTE_AFTER[i] });
});
---

<BaseLayout
  title="Client Stories: Real Buyers, Real Decisions"
  description="Real stories from Lawrence's buyers — first-time owners, upgraders, retirees and investors. See how the 222 Blueprint helped each of them buy right."
>
  <JsonLd slot="head" data={clientStoriesSchema({ siteUrl, url: canonical, stories: STORIES })} />
  <JsonLd
    slot="head"
    data={breadcrumbSchema([
      { name: 'Home', url: new URL(url('/'), Astro.site).href },
      { name: 'Client Stories', url: canonical },
    ])}
  />
  <section class="bg-navy-900 pt-14 pb-8 text-white sm:pt-20 sm:pb-10">
    <div class="container-site">
      <h1 class="mb-4 text-[32px] leading-tight text-white sm:text-5xl">Client Stories</h1>
      <div class="mb-5 h-px w-16 bg-gold-500"></div>
      <p class="max-w-2xl text-[17px] leading-[1.8] text-navy-100">
        Real stories from real buyers — every one of them a journey from first chat to keys in
        hand. The 222 Blueprint is my structured home-buying advisory method — helping buyers
        clarify needs, budget and location before they commit.
      </p>

      {/* Count-up social proof — numbers tick up on scroll (1.6s), final
          values are in the markup so they still show without JavaScript. */}
      <div class="mt-9 flex flex-wrap gap-x-12 gap-y-6">
        <div>
          <p class="text-[34px] leading-none font-extrabold text-white sm:text-[44px]">
            <span class="ts-count" data-count="2000">2,000</span>+
          </p>
          <p class="label-sm mt-2 text-gold-500">Buyers Trusted Over the Years</p>
        </div>
        <div>
          <p class="text-[34px] leading-none font-extrabold text-white sm:text-[44px]">
            <span class="ts-count" data-count="1500">1,500</span>+
          </p>
          <p class="label-sm mt-2 text-gold-500">Homeowners Served</p>
        </div>
        <div>
          <StarRating size={30} class="justify-center sm:gap-1 [&_svg]:h-[30px] [&_svg]:w-[30px] sm:[&_svg]:h-11 sm:[&_svg]:w-11" />
          <p class="label-sm mt-2 text-gold-500">Every Story, Five Stars</p>
        </div>
      </div>
    </div>

    {/* Auto-scrolling filmstrip of real signing photos — pure-CSS marquee,
        pauses on hover/touch, hand-swipeable. Decorative (aria-hidden). */}
    <div class="card-marquee mt-10" aria-hidden="true">
      <div class="card-marquee-track" style="--cm-dur: 42s">
        {[0, 1, 2].map(() => (
          <div class="flex gap-3 pr-3">
            {FILMSTRIP.map((s) => (
              <img
                src={url(s.image)}
                alt=""
                loading="lazy"
                class="h-16 w-16 flex-none rounded-[3px] object-cover opacity-90 ring-1 ring-white/15 sm:h-20 sm:w-20"
              />
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-12 sm:py-16">
    <div class="container-site">
      <div id="ts-wall" class="ts-wall">
        {ITEMS.map((item) =>
          item.kind === 'story' ? (
            <figure class="ts-card mb-4 break-inside-avoid overflow-hidden rounded-[4px] border border-border bg-white sm:mb-6">
              {item.data.image && (
                <button
                  type="button"
                  class="ts-photo group block w-full cursor-zoom-in overflow-hidden bg-navy-900"
                  data-full={url(item.data.image)}
                  aria-label={`Enlarge ${item.data.name}’s signing photo`}
                >
                  <img
                    src={url(item.data.image)}
                    alt={`${item.data.name} — signing story`}
                    loading="lazy"
                    class="w-full transition-transform duration-500 ease-out group-hover:scale-[1.06]"
                  />
                </button>
              )}
              <figcaption class="p-4 sm:p-6">
                <p class="text-[15px] leading-snug font-bold text-navy-900 sm:text-lg">{item.data.title}</p>
                <p class="mt-2.5 text-[13px] leading-[1.6] text-ink sm:mt-3 sm:text-[15.5px] sm:leading-[1.75]">{item.data.body}</p>
                <div class="mt-4 border-t border-border pt-3.5 sm:mt-5 sm:pt-4">
                  <p class="label-sm text-gold-600">{item.data.name} · {item.data.role}</p>
                  <StarRating size={15} class="mt-1.5" />
                </div>
              </figcaption>
            </figure>
          ) : (
            <figure class="ts-card mb-4 flex break-inside-avoid items-center rounded-[4px] bg-navy-900 p-6 sm:mb-6 sm:p-7">
              <p class="text-[19px] leading-snug font-bold text-gold-500 sm:text-[22px]">{item.text}</p>
            </figure>
          )
        )}
      </div>
    </div>
  </section>

  {/* Lightbox — click any photo to enlarge. Hidden and inert without JS. */}
  <div id="ts-lightbox" class="ts-lightbox" hidden>
    <img id="ts-lightbox-img" src="" alt="Signing photo enlarged" />
  </div>

  <style is:global>
    /* Balanced masonry: the script packs each card into the shortest column so
       there are never white gaps mid-page. Without JavaScript the wall falls
       back to a single full-width column — still gap-free, just not staggered. */
    .ts-wall {
      display: flex;
      flex-direction: column;
    }
    .ts-wall.ts-cols {
      flex-direction: row;
      align-items: flex-start;
      gap: 1rem;
    }
    @media (min-width: 640px) {
      .ts-wall.ts-cols {
        gap: 1.5rem;
      }
    }
    .ts-wall .ts-col {
      display: flex;
      flex-direction: column;
      flex: 1 1 0;
      min-width: 0;
    }
    /* Photos reveal by cascading up as they scroll in — the .ts-ready flag is
       only added by the script below, so without JS the cards stay visible. */
    .ts-ready .ts-card {
      opacity: 0;
      transform: translateY(26px) scale(0.96);
      transition:
        opacity 0.55s ease,
        transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .ts-ready .ts-card.is-in {
      opacity: 1;
      transform: none;
    }
    @media (prefers-reduced-motion: reduce) {
      .ts-ready .ts-card {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
    /* Lightbox overlay */
    .ts-lightbox {
      position: fixed;
      inset: 0;
      z-index: 60;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: rgb(7 26 48 / 0.92);
      cursor: zoom-out;
    }
    .ts-lightbox[hidden] {
      display: none;
    }
    .ts-lightbox img {
      max-height: 90vh;
      max-width: 92vw;
      border-radius: 4px;
      box-shadow: 0 24px 70px rgb(0 0 0 / 0.5);
    }
  </style>

  <script is:inline>
    (function () {
      // Balanced masonry — place each card into the currently shortest column
      // so the wall packs tight with no white gaps. Re-runs after images load
      // and on resize. Without this the CSS falls back to one column.
      var wall = document.getElementById('ts-wall');
      if (wall) {
        var cards = Array.prototype.slice.call(wall.querySelectorAll('.ts-card'));
        var layout = function () {
          var n = window.matchMedia('(min-width: 1024px)').matches ? 3 : 2;
          wall.classList.add('ts-cols');
          wall.innerHTML = '';
          var cols = [];
          for (var i = 0; i < n; i++) {
            var d = document.createElement('div');
            d.className = 'ts-col';
            wall.appendChild(d);
            cols.push(d);
          }
          cards.forEach(function (card) {
            var min = 0;
            for (var j = 1; j < n; j++) {
              if (cols[j].offsetHeight < cols[min].offsetHeight) min = j;
            }
            cols[min].appendChild(card);
          });
        };
        layout();
        window.addEventListener('load', layout);
        var rzt;
        var lastW = window.innerWidth;
        window.addEventListener('resize', function () {
          // Mobile browsers fire `resize` whenever the address bar shows or
          // hides while scrolling — that's a height-only change. Rebuilding the
          // masonry on those events collapses the wall for a frame and yanks the
          // page back to the top mid-scroll, so only relayout on a real WIDTH
          // change (orientation flip, desktop window resize).
          if (window.innerWidth === lastW) return;
          lastW = window.innerWidth;
          clearTimeout(rzt);
          rzt = setTimeout(layout, 200);
        });
      }

      // Count-up stats (1.6s, ease-out) — same technique as the homepage bar.
      var nums = document.querySelectorAll('.ts-count[data-count]');
      if (nums.length && 'IntersectionObserver' in window) {
        nums.forEach(function (el) {
          el.textContent = '0';
        });
        var cio = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (en) {
              if (!en.isIntersecting) return;
              var el = en.target;
              cio.unobserve(el);
              var target = parseInt(el.getAttribute('data-count'), 10);
              var dur = 1600;
              var start = performance.now();
              var tick = function (now) {
                var p = Math.min((now - start) / dur, 1);
                el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3))).toLocaleString('en-US');
                if (p < 1) requestAnimationFrame(tick);
              };
              requestAnimationFrame(tick);
            });
          },
          { threshold: 0.6 }
        );
        nums.forEach(function (el) {
          cio.observe(el);
        });
      }

      // Staggered card reveal on scroll.
      if ('IntersectionObserver' in window) {
        document.documentElement.classList.add('ts-ready');
        var rio = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                rio.unobserve(e.target);
              }
            });
          },
          // Reveal well before a card enters view so it is never blank on screen
          { threshold: 0, rootMargin: '0px 0px 320px 0px' }
        );
        document.querySelectorAll('.ts-card').forEach(function (c) {
          rio.observe(c);
        });
      }

      // Lightbox — enlarge a signing photo on click.
      var lb = document.getElementById('ts-lightbox');
      var lbImg = document.getElementById('ts-lightbox-img');
      if (lb && lbImg) {
        document.querySelectorAll('.ts-photo').forEach(function (b) {
          b.addEventListener('click', function () {
            lbImg.src = b.getAttribute('data-full');
            lb.hidden = false;
            document.body.style.overflow = 'hidden';
          });
        });
        var closeLb = function () {
          lb.hidden = true;
          lbImg.src = '';
          document.body.style.overflow = '';
        };
        lb.addEventListener('click', closeLb);
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !lb.hidden) closeLb();
        });
      }
    })();
  </script>

  <CTASection
    heading="The next signing story could be yours"
    sub="Wherever you are — just starting to look, comparing projects, or ready to sign — let’s have a chat first."
    waMessage="Hi Lawrence, I read your client stories and would like to chat about buying a property."
  />
</BaseLayout>
