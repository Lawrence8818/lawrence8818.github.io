---
// Client Stories — the final 30 testimonials, in an intentional display
// order (strongest social proof first, loan stories spread out, emotional
// close at the end). No project names or locations on any card.
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import StarRating from '../components/StarRating.astro';
import { url } from '../lib/url';

interface Story {
  title: string;
  body: string;
  name: string;
  role: string;
  /** photo under public/images; omitted = text-only card */
  image?: string;
}

