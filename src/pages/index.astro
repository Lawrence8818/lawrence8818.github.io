---
import Picture from '../components/Picture.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import PillarsAndStory from '../components/PillarsAndStory.astro';
import SectionHeading from '../components/SectionHeading.astro';
import GoldIcon from '../components/GoldIcon.astro';
import VideoCard from '../components/VideoCard.astro';
import CTASection from '../components/CTASection.astro';
import MatchQuiz from '../components/MatchQuiz.astro';
import StarRating from '../components/StarRating.astro';
import { SERVICES } from '../data/services';
import { SITE } from '../data/site';
import { url } from '../lib/url';
import { landingHref } from '../lib/landing';
import { instalmentDisplay, instalmentDisplayZh, LABEL_ZH, monthlyNumber, REGION_LABEL, REGION_LABEL_ZH } from '../lib/property-facts';
import { waLink, waContextMessage, WA_DEFAULT_ZH, WA_LEADMAGNET_ZH } from '../lib/whatsapp';
import { langOf, pick, href } from '../i18n';
import { HERO_SHORT_ZH, MARQUEE_SHORT_ZH, SERVICES_ZH } from '../i18n/copy-zh';

// 这个模板同时出英文首页(/)和中文首页(/zh/)
const lang = langOf(Astro);
const zh = lang === 'zh';

const videos = (await getCollection('videos'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const featuredVideos = [...videos.filter((v) => v.data.featured), ...videos]
  .filter((v, i, arr) => arr.indexOf(v) === i)
  .slice(0, 3);

const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);

const properties = (await getCollection('properties')).sort((a, b) => a.data.order - b.data.order);
// Home rail shows a short curated set only; the full paginated list lives at /properties/.
const featuredProperties = [...properties.filter((p) => p.data.featured), ...properties]
  .filter((p) => !p.data.soldOut)
  .filter((p, i, arr) => arr.indexOf(p) === i)
  .slice(0, 6);

// 精选项目下面的快捷入口:按月供、按区域。数字是在售项目里实际符合的个数,
// 和 All Properties 页的筛选用同一套规则(没有月供数字的项目不算进月供档)。
const live = properties.filter((p) => !p.data.soldOut);
const monthlyOf = (p: (typeof properties)[number]) => monthlyNumber(p.data.monthly);
const inBand = (lo: number, hi: number) =>
  live.filter((p) => { const m = monthlyOf(p); return !!m && m >= lo && m <= hi; }).length;
const quickLinks = [
  {
    title: pick(lang, 'By monthly instalment', '按月供'),
    items: [
      { label: pick(lang, 'Under RM2,000', 'RM2,000 以下'), q: 'mmax=2000', n: inBand(0, 2000) },
      { label: 'RM2,000 – 3,500', q: 'mmin=2000&mmax=3500', n: inBand(2000, 3500) },
      { label: 'RM3,500 – 6,000', q: 'mmin=3500&mmax=6000', n: inBand(3500, 6000) },
      { label: pick(lang, 'Above RM6,000', 'RM6,000 以上'), q: 'mmin=6000', n: inBand(6000, Infinity) },
    ],
  },
  {
    title: pick(lang, 'By area', '按区域'),
    items: (['kuala-lumpur', 'klcc', 'petaling-jaya', 'selangor', 'johor', 'penang'] as const).map((r) => ({
      label: zh ? REGION_LABEL_ZH[r] : REGION_LABEL[r],
      q: `region=${r}`,
      n: live.filter((p) => p.data.region === r).length,
    })),
  },
].map((row) => ({ ...row, items: row.items.filter((c) => c.n > 0) }));

const testimonials = (await getCollection('testimonials')).slice(0, 6);

// 滚动字条只放服务范围;年资、买家数、排名这些数字只在下面的数据条出现一次
const marqueeItems = zh ? MARQUEE_SHORT_ZH :
  'KUALA LUMPUR · SELANGOR · JOHOR · PENANG · NEW LAUNCH ADVISORY · LOAN PLANNING · VIEWING ARRANGEMENTS · END-TO-END SUPPORT · HONEST, NO-PRESSURE ADVICE · ';
---

<BaseLayout
  title={pick(
    lang,
    `${SITE.name} — New Property Specialist, KL & Selangor`,
    `${SITE.name} ${SITE.nameZh}｜吉隆坡、雪兰莪新盘专家`,
  )}
  description={pick(
    lang,
    'Full coverage of every new launch in KL & Selangor, plus Johor and Penang. 10 years in real estate, 2,000+ happy buyers. Honest, no-pressure advice — free consultation on WhatsApp.',
    '吉隆坡和雪兰莪的新盘全面覆盖，也做柔佛和槟城。入行十年，2,000 多位买家的信任。说实话、不催促——WhatsApp 免费咨询。',
  )}
  noTitleTemplate
>
  {/* ===== Hero: editorial, oversized type ===== */}
  <section class="bg-navy-900 text-white">
    <div class="hero-grid container-site py-14 sm:py-20">
      <div class="hero-top">
        <p class="label-sm mb-6 text-gold-500">
          {SITE.renNumber} · {pick(lang, 'KL / PJ / SELANGOR / JOHOR / PENANG', '吉隆坡 / 八打灵再也 / 雪兰莪 / 柔佛 / 槟城')}
        </p>
        <h1 class="text-[clamp(2.6rem,8vw,5.5rem)] leading-[1.02] tracking-tight text-white uppercase">
          Lawrence<br />Law <span class="text-gold-500">刘智权</span>
        </h1>
        <p class="mt-6 text-sm font-bold tracking-[3px] text-white uppercase sm:text-base">
          {pick(lang, 'New Property Specialist', '新盘专家')} <span class="text-gold-500">/</span> {pick(lang, 'Subsales Expertise', '二手房实战经验')}
        </p>
      </div>
      <div class="hero-photo mx-auto w-full max-w-[240px] sm:max-w-xs lg:max-w-sm">
        <Picture
          src={'/images/lawrence-portrait.jpg'}
          fallback="/images/placeholders/lawrence-portrait.svg"
          sizes="(min-width: 1024px) 384px, 320px"
          alt={pick(lang, 'Lawrence Law, New Property Specialist', 'Lawrence Law 刘智权，新盘专家')}
          class="plx aspect-[4/5] w-full object-cover"
          fetchpriority="high"
        />
      </div>
      <div class="hero-body">
        {/* 首屏只留一句定位 + 奖项一行;完整的个人介绍在 About 页 */}
        <p class="max-w-xl text-[17px] leading-relaxed text-white sm:text-lg">
          {pick(
            lang,
            'I help young couples, families and first-time buyers choose the right new home in KL & Selangor — honest, no-pressure advice from someone who has worked both subsales and new projects.',
            HERO_SHORT_ZH.lead,
          )}
        </p>
        <p class="mt-4 max-w-xl border-l-2 border-gold-500 pl-4 text-sm leading-relaxed text-navy-100">
          {pick(
            lang,
            'Top 47 nationwide (Primary Market, 2025) · Million Dollar Achiever Club — Diamond, IQI Prestige Awards',
            HERO_SHORT_ZH.awards,
          )}
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={waLink(pick(lang, undefined, WA_DEFAULT_ZH))} target="_blank" rel="noopener" class="btn-gold" data-track="whatsapp_hero">
            {pick(lang, 'Let’s Talk', '聊一聊')}
          </a>
          <a href={waLink(pick(lang, SITE.leadMagnetMessage, WA_LEADMAGNET_ZH))} target="_blank" rel="noopener" class="btn-gold-outline text-white" data-track="whatsapp_hero_leadmagnet">
            {pick(lang, 'Free Buyer’s Guide', '免费买房指南')}
          </a>
        </div>
        <p class="mt-5">
          <a href={href(lang, '/about/')} class="inline-flex min-h-11 items-center text-sm font-semibold text-gold-500 hover:text-gold-600">
            {pick(lang, 'Read my full story →', HERO_SHORT_ZH.story)}
          </a>
        </p>
      </div>
    </div>
  </section>

  <style is:global>
    /* Hero layout: stacked on mobile (name → intro → buttons → photo),
       side-by-side on desktop (text left, portrait right, vertically centred). */
    .hero-grid {
      display: grid;
      gap: 2.5rem;
      grid-template-areas: 'top' 'body' 'photo';
    }
    .hero-top { grid-area: top; }
    .hero-photo { grid-area: photo; }
    .hero-body { grid-area: body; }
    @media (min-width: 1024px) {
      .hero-grid {
        grid-template-columns: 3fr 2fr;
        column-gap: 2.5rem;
        row-gap: 1.5rem;
        align-items: center;
        grid-template-areas:
          'top   photo'
          'body  photo';
      }
      .hero-photo { align-self: center; }
    }
  </style>

  {/* ===== Marquee strip ===== */}
  <div class="marquee border-y border-gold-500/30 bg-navy-950 py-3" aria-hidden="true">
    <div class="marquee-track label-sm text-gold-500">
      <span>{marqueeItems}</span><span>{marqueeItems}</span>
    </div>
  </div>

  {/* ===== Stats: white editorial ===== */}
  <TrustBar />

  {/* ===== Featured Properties: auto-playing card marquee =====
      Pure CSS (same technique as the text strip) so it runs even on
      platforms that strip JS. Pauses on hover / touch-hold / focus. */}
  <section class="section-pad bg-white">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading title={pick(lang, 'Featured Properties', '精选项目')} sub={pick(lang, 'Premium Developments · Kuala Lumpur & Selangor', '优质发展项目 · 吉隆坡与雪兰莪')} />
        <a href={href(lang, '/allproperties/')} class="btn-gold-outline mb-8 hidden text-navy-900 sm:inline-flex">
          {pick(lang, 'View ALL Properties', '查看全部项目')}
        </a>
      </div>
    </div>
    <div class="card-marquee pb-4">
      <div class="card-marquee-track" style="--cm-dur: 72s">
        {[0, 1, 2].map((copy) => (
          <div class="flex gap-6 pr-6 pl-0" aria-hidden={copy > 0 ? 'true' : undefined}>
            {featuredProperties.map((p) => (
              <div class="group w-[280px] sm:w-[340px] lg:w-[400px]">
                <a href={(zh ? href(lang, `/properties/${p.id}/`) : landingHref(p.data.landingUrl) || url(`/properties/${p.id}/`))} class="block" tabindex={copy > 0 ? -1 : undefined}>
                  <div class="relative aspect-[4/3] overflow-hidden bg-navy-900">
                    <Picture
                      src={p.data.image}
                      fallback={p.data.fallbackImage}
                      sizes="(min-width: 1024px) 400px, (min-width: 640px) 340px, 280px"
                      alt={p.data.name}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                    {p.data.label && (
                      <span class="label-sm absolute top-3 left-3 bg-gold-500 px-3 py-1 text-navy-900">
                        {zh ? (LABEL_ZH[p.data.label] ?? p.data.label) : p.data.label}
                      </span>
                    )}
                    {p.data.placeholder && (
                      <span class="absolute top-3 right-3 rounded bg-navy-900/85 px-2 py-0.5 text-xs text-white">
                        等待 · Photo pending
                      </span>
                    )}
                  </div>
                </a>
                <div class="mt-4 flex items-baseline justify-between gap-4 border-b border-border pb-4">
                  <div class="min-w-0">
                    <p class="truncate font-extrabold tracking-tight text-navy-900 uppercase">{p.data.name}</p>
                    <p class="text-sm text-ink/60">{p.data.location}</p>
                  </div>
                  <p class="flex-none font-bold text-navy-900">
                    {(() => {
                      const i = zh ? instalmentDisplayZh(p.data) : instalmentDisplay(p.data);
                      return i.amount ? pick(lang, `From ${i.text}/mo`, `月供 ${i.text} 起`) : i.text;
                    })()} <span class="text-gold-500">→</span>
                  </p>
                </div>
                <div class="mt-1 flex gap-5 text-sm">
                  <a href={waLink(waContextMessage(p.data.name, lang))} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center font-semibold text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4" data-track="whatsapp_property" tabindex={copy > 0 ? -1 : undefined}>
                    {pick(lang, 'Contact Us', '联系我')}
                  </a>
                  <a href={(zh ? href(lang, `/properties/${p.id}/`) : landingHref(p.data.landingUrl) || url(`/properties/${p.id}/`))} class="inline-flex min-h-11 items-center font-semibold text-ink/60 hover:text-navy-900" tabindex={copy > 0 ? -1 : undefined}>
                    {pick(lang, 'Details', '详情')}
                  </a>
                </div>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
    {/* 快捷入口:直接带到 All Properties 页对应的筛选(月供 / 区域) */}
    <div class="container-site mt-8 space-y-4">
      {quickLinks.map((row) => (
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="label-sm w-full text-ink/60 sm:w-auto sm:pr-2">{row.title}</span>
          {row.items.map((c) => (
            <a
              href={`${href(lang, '/allproperties/')}?${c.q}`}
              class="label-sm inline-flex min-h-11 items-center rounded-full border border-navy-900/25 px-4 py-2 text-navy-900 transition hover:border-gold-500 hover:bg-gold-500"
              data-track="home_quick_filter"
            >
              {c.label} <span class="ml-1 opacity-60">({c.n})</span>
            </a>
          ))}
        </div>
      ))}
    </div>
    <div class="container-site mt-8 text-center sm:hidden">
      <a href={href(lang, '/allproperties/')} class="btn-gold-outline text-navy-900">{pick(lang, 'View ALL Properties', '查看全部项目')}</a>
    </div>
  </section>

  {/* ===== 30-second property match quiz ===== */}
  <MatchQuiz />

  {/* ===== Testimonials: navy band =====
      Prev/next arrows mirror the Featured Properties rail: without JS they are
      anchor links that scroll the rail card by card via :target + :has()
      (works on platforms that strip scripts); with JS they upgrade to smooth
      scroll buttons plus a gentle auto-advance that pauses on interaction. */}
  <section id="testimonials" class="section-pad scroll-mt-20 bg-navy-900">
    <div class="container-site">
      <SectionHeading title={pick(lang, 'What others are saying', '客户怎么说')} sub={pick(lang, 'Testimonials', '客户见证')} tone="light" />
      <p class="-mt-4 max-w-2xl text-navy-100">
        {pick(
          lang,
          'The 222 Blueprint is my structured home-buying advisory method — helping buyers clarify needs, budget and location before they commit.',
          '222 Blueprint 是我自己的一套买房咨询方法：在下决定之前，先帮买家把需求、预算和地点理清楚。以下是客户的原话，保留英文原文。',
        )}
      </p>
    </div>

    <div class="card-marquee mt-8 pb-4">
      <div class="card-marquee-track cm-reverse" style="--cm-dur: 88s">
        {[0, 1, 2].map((copy) => (
          <div class="flex gap-6 pr-6" aria-hidden={copy > 0 ? 'true' : undefined}>
            {testimonials.map((t) => (
              <figure class="flex w-[280px] flex-col overflow-hidden rounded-[4px] bg-white/10 backdrop-blur-sm sm:w-[340px] lg:w-[368px]">
                <div class="relative aspect-[4/3] flex-none overflow-hidden bg-navy-950">
                  <Picture
                    src={t.data.image}
                    fallback={t.data.fallbackImage}
                    sizes="(min-width: 1024px) 368px, (min-width: 640px) 340px, 280px"
                    alt={`${t.data.name} — happy buyer`}
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                  {t.data.placeholder && (
                    <span class="absolute top-2 right-2 rounded bg-navy-900/85 px-2 py-0.5 text-xs text-white">
                      等待 · Photo pending
                    </span>
                  )}
                </div>
                <div class="flex flex-1 flex-col p-6 pt-5">
                  <p class="text-[17px] leading-snug font-bold text-white">“{t.data.title}”</p>
                  <blockquote class="mt-2 line-clamp-6 flex-1 text-[15px] leading-relaxed text-navy-100">
                    {t.data.quote}
                  </blockquote>
                  <figcaption class="mt-4">
                    <span class="label-sm text-gold-500">{t.data.name}{t.data.role && ` · ${t.data.role}`}</span>
                    <StarRating size={14} class="mt-1" />
                  </figcaption>
                </div>
              </figure>
            ))}
          </div>
        ))}
      </div>
    </div>

    <div class="container-site mt-6 text-center">
      <a href={url('/spasignings/')} class="btn-gold-outline text-white">{pick(lang, 'More Client Stories', '更多客户故事（英文）')}</a>
    </div>
  </section>

  {/* ===== Services ===== */}
  <section class="section-pad border-t border-border bg-white">
    <div class="container-site">
      <SectionHeading title={pick(lang, 'How I Can Help', '我能帮你什么')} sub={pick(lang, 'Services', '服务项目')} />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {SERVICES.map((s, i) => (
          <div class="card">
            <span class="text-gold-500"><GoldIcon name={s.icon} size={32} /></span>
            <h3 class="mt-4 text-lg tracking-tight uppercase">{zh ? SERVICES_ZH[i].title : s.title}</h3>
            <p class="mt-2 text-[15px] text-ink/80">{zh ? SERVICES_ZH[i].description : s.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ===== Self-introduction: pillars + first-deal story (shared with About) ===== */}
  <PillarsAndStory brief />

  {/* ===== Videos =====
      中文版暂时不出这一区:视频页还没有中文版,点进去会是英文页。 */}
  {!zh && (
  <section id="videos" class="section-pad scroll-mt-20 border-t border-border bg-white">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading title="Watch First, Buy Smarter" sub="Videos" />
        <a href={url('/videos/')} class="mb-8 hidden min-h-11 items-center text-sm font-semibold text-gold-600 hover:underline sm:inline-flex">
          All videos →
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredVideos.map((v) => (
          <VideoCard
            slug={v.id}
            title={v.data.title}
            titleZh={v.data.titleZh}
            category={v.data.category}
            platform={v.data.platform}
            thumbnail={v.data.thumbnail}
            videoId={v.data.videoId}
            longform={v.data.longform}
          />
        ))}
      </div>
      <a href={url('/videos/')} class="mt-6 inline-flex min-h-11 w-full items-center justify-center text-center text-sm font-semibold text-gold-600 hover:underline sm:hidden">
        All videos →
      </a>
    </div>
  </section>
  )}

  {/* ===== Areas =====
      中文版暂时不出这一区:区域页还没有中文版。 */}
  {!zh && (
  <section id="areas" class="section-pad scroll-mt-20 bg-white">
    <div class="container-site">
      <SectionHeading title="Areas I Serve" sub="Coverage" />
      {/* 精简成一排入口:区域介绍在各自的区域页里,首页只负责带路。
 */}
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {[
          ...areas.map((a) => ({ name: a.data.name, to: url(`/areas/${a.id}/`), main: a.id === 'bukit-jalil' })),
        ].map((a) => (
          <a
            href={a.to}
            class={`group flex min-h-16 items-center justify-between gap-2 rounded-[4px] border px-4 py-3 transition-colors hover:border-gold-500 ${a.main ? 'border-gold-500/60' : 'border-border'}`}
          >
            <span class="text-[15px] leading-tight font-bold tracking-tight text-navy-900 uppercase group-hover:text-gold-600">{a.name}</span>
            <span class="flex-none text-gold-500" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  )}

  <CTASection />
</BaseLayout>
